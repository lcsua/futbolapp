<!DOCTYPE html>
@{
    var homeLeagueSlug = ViewBag.LeagueSlug as string;
}
<html lang="es"
      data-path-base="@(Context.Request.PathBase.HasValue ? Context.Request.PathBase.Value : "")"
      data-home-league="@homeLeagueSlug">
@{
    var seoUrls = Context.RequestServices.GetRequiredService<PublicWeb.Seo.SeoUrlBuilder>();
    var seoOptions = Context.RequestServices.GetRequiredService<Microsoft.Extensions.Options.IOptions<PublicWeb.Seo.SeoOptions>>().Value;
    var title = ViewData["Title"] as string ?? "MiLiga";
    // Titles from SeoCopy already include "| MiLiga"; legacy pages may not.
    if (!title.Contains("MiLiga", StringComparison.OrdinalIgnoreCase) &&
        !title.Contains("Mi Liga", StringComparison.OrdinalIgnoreCase))
    {
        title = $"{title} | MiLiga";
    }
    var description = ViewData["Description"] as string
        ?? "Resultados, posiciones, partidos y estadísticas de tu torneo.";
    var canonicalPath = ViewData["CanonicalPath"] as string
        ?? Context.Request.Path.Value
        ?? "/";
    var canonical = seoUrls.Absolute(canonicalPath);
    var ogImage = seoUrls.AbsoluteMedia(ViewData["OgImage"] as string);
    var ogType = ViewData["OgType"] as string ?? "website";
    var allowIndexing = seoOptions.AllowIndexing;
    var noIndex = !allowIndexing || ViewData["NoIndex"] as bool? == true;
    var crumbs = ViewBag.SeoBreadcrumbs as IReadOnlyList<PublicWeb.Seo.SeoBreadcrumbItem>;
    var breadcrumbJson = PublicWeb.Seo.SeoJsonLd.BreadcrumbList(crumbs, seoUrls);
    var siteJson = PublicWeb.Seo.SeoJsonLd.WebsiteAndOrganization(seoUrls, seoOptions);
}
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@title</title>

    <meta name="description" content="@description" />
    @if (noIndex)
    {
        <meta name="robots" content="@(allowIndexing ? "noindex, follow" : "noindex, nofollow")" />
    }
    <link rel="canonical" href="@canonical" />

    <meta property="og:title" content="@title" />
    <meta property="og:description" content="@description" />
    <meta property="og:type" content="@ogType" />
    <meta property="og:url" content="@canonical" />
    <meta property="og:image" content="@ogImage" />
    <meta property="og:site_name" content="@seoOptions.SiteName" />
    <meta property="og:locale" content="es_AR" />

    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content="@title" />
    <meta name="twitter:description" content="@description" />
    <meta name="twitter:image" content="@ogImage" />

    <meta name="theme-color" content="#0F172A" />

    <link id="miliga-favicon" rel="icon" href="~/branding/favicon.ico" asp-append-version="true" sizes="any" />
    <link id="miliga-favicon-32" rel="icon" type="image/png" sizes="32x32" href="~/branding/favicon-32x32.png" asp-append-version="true" />
    <link id="miliga-favicon-16" rel="icon" type="image/png" sizes="16x16" href="~/branding/favicon-16x16.png" asp-append-version="true" />
    <link id="miliga-apple-touch" rel="apple-touch-icon" sizes="180x180" href="~/branding/apple-touch-icon.png" asp-append-version="true" />
    <link rel="manifest" href="~/branding/site.webmanifest" asp-append-version="true" />

    @if (allowIndexing)
    {
    <!-- Google tag (gtag.js) -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-RDP3H0YFV9"></script>
    <script>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-RDP3H0YFV9');
    </script>

    <!-- Microsoft Clarity -->
    <script type="text/javascript">
        (function(c,l,a,r,i,t,y){
            c[a]=c[a]||function(){(c[a].q=c[a].q||[]).push(arguments)};
            t=l.createElement(r);t.async=1;t.src="https://www.clarity.ms/tag/"+i;
            y=l.getElementsByTagName(r)[0];y.parentNode.insertBefore(t,y);
        })(window, document, "clarity", "script", "xyv8aibxjo");
    </script>
    }

    <link rel="icon" href="~/branding/blue/favicon.ico" asp-append-version="true" sizes="any" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/v2/v2.css" asp-append-version="true" />

    @if (string.Equals(ViewBag.V2ActiveNav as string, "home", StringComparison.Ordinal))
    {
        <script>
            (function () {
              try {
                var params = new URLSearchParams(location.search);
                if (params.has('inicio') || params.has('todas')) return;
                if (/bot|crawl|spider|slurp|googlebot|bingbot|yandex|facebookexternalhit/i.test(navigator.userAgent)) return;
                var path = localStorage.getItem('miliga-home-league') || localStorage.getItem('miliga-last-league');
                if (!path || !/^(argentina\/)?[a-z0-9]+(?:-[a-z0-9]+)*$/.test(path)) return;
                var base = (document.documentElement.getAttribute('data-path-base') || '').replace(/\/$/, '');
                location.replace(base + '/ligas/' + path);
              } catch (e) {}
            })();
        </script>
    }

    <script type="application/ld+json">@Html.Raw(siteJson)</script>
    @if (!string.IsNullOrWhiteSpace(breadcrumbJson))
    {
        <script type="application/ld+json">@Html.Raw(breadcrumbJson)</script>
    }
</head>
<body>
<div class="v2-app@(ViewBag.OverlayGlobalHeader == true ? " v2-app--hero-header" : null)" id="v2-app-root">
    @await Html.PartialAsync("~/Views/Shared/V2/_V2Header.cshtml")

    <main class="v2-main@(ViewBag.LeagueDetails == true ? " v2-league-details" : null)">
        <div class="v2-shell">
            @RenderBody()
        </div>
    </main>

    @await Html.PartialAsync("~/Views/Shared/V2/_V2Footer.cshtml")
</div>

<script src="~/js/v2/theme.js" asp-append-version="true"></script>
<script src="~/js/v2/team-badge.js" asp-append-version="true"></script>
<script src="~/js/v2/share.js" asp-append-version="true"></script>
<script src="~/js/v2/follow.js" asp-append-version="true"></script>
<script src="~/js/v2/home-league.js" asp-append-version="true"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
