<!DOCTYPE html>
<html lang="es" data-path-base="@(Context.Request.PathBase.HasValue ? Context.Request.PathBase.Value : "")">
@{
    var seoUrls = Context.RequestServices.GetRequiredService<PublicWeb.Seo.SeoUrlBuilder>();
    var seoOptions = Context.RequestServices.GetRequiredService<Microsoft.Extensions.Options.IOptions<PublicWeb.Seo.SeoOptions>>().Value;
    var title = ViewData["Title"] as string ?? "MiLiga";
    // Titles from SeoCopy already include "| MiLiga"; legacy pages may not.
    if (!title.Contains("MiLiga", StringComparison.OrdinalIgnoreCase) &&
        !title.Contains("Mi Liga", StringComparison.OrdinalIgnoreCase))
    {
        title = $"{title} | MiLiga";
    }
    var description = ViewData["Description"] as string
        ?? "Resultados, posiciones, partidos y estadísticas de tu torneo.";
    var canonicalPath = ViewData["CanonicalPath"] as string
        ?? Context.Request.Path.Value
        ?? "/";
    var canonical = seoUrls.Absolute(canonicalPath);
    var ogImage = seoUrls.AbsoluteMedia(ViewData["OgImage"] as string);
    var ogType = ViewData["OgType"] as string ?? "website";
    var noIndex = ViewData["NoIndex"] as bool? == true;
    var crumbs = ViewBag.SeoBreadcrumbs as IReadOnlyList<PublicWeb.Seo.SeoBreadcrumbItem>;
    var breadcrumbJson = PublicWeb.Seo.SeoJsonLd.BreadcrumbList(crumbs, seoUrls);
    var siteJson = PublicWeb.Seo.SeoJsonLd.WebsiteAndOrganization(seoUrls, seoOptions);
}
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@title</title>

    <script>
        (function () {
            try {
                var t = localStorage.getItem('miliga-v2-theme');
                if (t !== 'green' && t !== 'blue') t = 'blue';
                document.documentElement.setAttribute('data-v2-theme-boot', t);
            } catch (e) {
                document.documentElement.setAttribute('data-v2-theme-boot', 'blue');
            }
        })();
    </script>

    <meta name="description" content="@description" />
    @if (noIndex)
    {
        <meta name="robots" content="noindex, follow" />
    }
    <link rel="canonical" href="@canonical" />

    <meta property="og:title" content="@title" />
    <meta property="og:description" content="@description" />
    <meta property="og:type" content="@ogType" />
    <meta property="og:url" content="@canonical" />
    <meta property="og:image" content="@ogImage" />
    <meta property="og:site_name" content="@seoOptions.SiteName" />
    <meta property="og:locale" content="es_AR" />

    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content="@title" />
    <meta name="twitter:description" content="@description" />
    <meta name="twitter:image" content="@ogImage" />

    <meta id="v2-theme-color" name="theme-color" content="#2563EB" />

    <link id="miliga-favicon" rel="icon" href="~/branding/favicon.ico" asp-append-version="true" sizes="any" />
    <link id="miliga-favicon-32" rel="icon" type="image/png" sizes="32x32" href="~/branding/favicon-32x32.png" asp-append-version="true" />
    <link id="miliga-favicon-16" rel="icon" type="image/png" sizes="16x16" href="~/branding/favicon-16x16.png" asp-append-version="true" />
    <link id="miliga-apple-touch" rel="apple-touch-icon" sizes="180x180" href="~/branding/apple-touch-icon.png" asp-append-version="true" />
    <link rel="manifest" href="~/branding/site.webmanifest" asp-append-version="true" />

    <!-- Google tag (gtag.js) -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-RDP3H0YFV9"></script>
    <script>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-RDP3H0YFV9');
    </script>

    <!-- Microsoft Clarity -->
    <script type="text/javascript">
        (function(c,l,a,r,i,t,y){
            c[a]=c[a]||function(){(c[a].q=c[a].q||[]).push(arguments)};
            t=l.createElement(r);t.async=1;t.src="https://www.clarity.ms/tag/"+i;
            y=l.getElementsByTagName(r)[0];y.parentNode.insertBefore(t,y);
        })(window, document, "clarity", "script", "xyv8aibxjo");
    </script>

    <link rel="icon" href="~/branding/blue/favicon.ico" asp-append-version="true" sizes="any" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/v2/v2.css" asp-append-version="true" />

    <script type="application/ld+json">@Html.Raw(siteJson)</script>
    @if (!string.IsNullOrWhiteSpace(breadcrumbJson))
    {
        <script type="application/ld+json">@Html.Raw(breadcrumbJson)</script>
    }
</head>
<body>
<div class="v2-app" id="v2-app-root" data-v2-theme="blue">
    <script>
        (function () {
            var root = document.getElementById('v2-app-root');
            if (!root) return;
            var t = document.documentElement.getAttribute('data-v2-theme-boot') || 'blue';
            root.setAttribute('data-v2-theme', t);
            var pathBase = document.documentElement.getAttribute('data-path-base') || '';
            var base = (pathBase.replace(/\/$/, '') || '') + '/branding/' + t;
            root.querySelectorAll('[data-v2-brand="logo-nav"]').forEach(function (img) {
                img.setAttribute('src', base + '/logo-dark.svg');
            });
            root.querySelectorAll('[data-v2-brand="icon"]').forEach(function (img) {
                img.setAttribute('src', base + '/icon.svg');
            });
            root.querySelectorAll('[data-v2-brand="icon-192"]').forEach(function (img) {
                img.setAttribute('src', base + '/icon-192.png');
            });
            var tc = document.getElementById('v2-theme-color');
            if (tc) tc.setAttribute('content', t === 'green' ? '#16A34A' : '#2563EB');
        })();
    </script>

    @await Html.PartialAsync("~/Views/Shared/V2/_V2Header.cshtml")

    <main class="v2-main">
        <div class="v2-shell">
            @RenderBody()
        </div>
    </main>

    @await Html.PartialAsync("~/Views/Shared/V2/_V2Footer.cshtml")
</div>

<script src="~/js/v2/theme.js" asp-append-version="true"></script>
<script src="~/js/v2/team-badge.js" asp-append-version="true"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
