@{
    var scopeType = ViewData["FollowScopeType"] as string ?? "League";
    var scopeId = ViewData["FollowScopeId"] as Guid? ?? Guid.Empty;
    var label = ViewData["FollowLabel"] as string ?? "Seguir";
    var followingLabel = ViewData["FollowFollowingLabel"] as string ?? "Siguiendo";
    var compact = ViewData["FollowCompact"] as bool? == true;
}
<div class="v2-follow @(compact ? "v2-follow--compact" : null)"
     data-v2-follow
     data-scope-type="@scopeType"
     data-scope-id="@scopeId"
     data-label="@label"
     data-following-label="@followingLabel"
     hidden>
    <button type="button"
            class="v2-follow-btn"
            data-v2-follow-trigger
            aria-pressed="false"
            aria-label="@label">
        <svg class="v2-follow-btn__icon" width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true" focusable="false">
            <path d="M15 17H9a3 3 0 0 0 6 0Z" stroke="currentColor" stroke-width="1.75" stroke-linejoin="round" />
            <path d="M6.5 10.5a5.5 5.5 0 0 1 11 0c0 3.2.9 4.4 1.5 5.5H5c.6-1.1 1.5-2.3 1.5-5.5Z" stroke="currentColor" stroke-width="1.75" stroke-linejoin="round" />
            <path d="M12 3.5v1.2" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" />
        </svg>
        <span class="v2-follow-btn__label" data-v2-follow-label>@label</span>
    </button>
    <p class="v2-follow-hint" data-v2-follow-hint hidden></p>
</div>
