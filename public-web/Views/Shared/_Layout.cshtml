<!DOCTYPE html>
<html lang="es" data-path-base="@(Context.Request.PathBase.HasValue ? Context.Request.PathBase.Value : "")">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Mi Liga</title>

    <!-- SEO and OpenGraph -->
    <meta name="description" content="@(ViewData["Description"] ?? "Gestioná tu liga de fútbol fácilmente con resultados, tabla y fixture automático.")" />
    <meta property="og:title" content="@ViewData["Title"] - Mi Liga" />
    <meta property="og:description" content="@(ViewData["Description"] ?? "Mi Liga es la plataforma para gestionar ligas de fútbol amateur.")" />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://miliga.com.ar" />
    <meta property="og:site_name" content="Mi Liga" />
    <meta name="theme-color" content="#0F172A" />

    <link id="miliga-favicon" rel="icon" href="~/branding/favicon.ico" asp-append-version="true" sizes="any" />
    <link id="miliga-favicon-32" rel="icon" type="image/png" sizes="32x32" href="~/branding/favicon-32x32.png" asp-append-version="true" />
    <link id="miliga-favicon-16" rel="icon" type="image/png" sizes="16x16" href="~/branding/favicon-16x16.png" asp-append-version="true" />
    <link id="miliga-apple-touch" rel="apple-touch-icon" sizes="180x180" href="~/branding/apple-touch-icon.png" asp-append-version="true" />
    <link rel="manifest" href="~/manifest.webmanifest" asp-append-version="true" />

    <!-- Google tag (gtag.js) -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-RDP3H0YFV9"></script>
    <script>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-RDP3H0YFV9');
    </script>

    <!-- Microsoft Clarity -->
    <script type="text/javascript">
        (function(c,l,a,r,i,t,y){
            c[a]=c[a]||function(){(c[a].q=c[a].q||[]).push(arguments)};
            t=l.createElement(r);t.async=1;t.src="https://www.clarity.ms/tag/"+i;
            y=l.getElementsByTagName(r)[0];y.parentNode.insertBefore(t,y);
        })(window, document, "clarity", "script", "xyv8aibxjo");
    </script>
    
    <!-- Bootstrap 5 -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-T3c6CoIi6uLrA9TneNEoa7RxnatzjcDSCmG1MXxSR1GAsXEV/Dwwykc2MPK8M2HN" crossorigin="anonymous">
    
    <!-- Custom CSS (theme tokens) -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="d-flex flex-column min-vh-100">
    
    <header>
        <nav class="navbar navbar-expand-lg navbar-dark miliga-navbar shadow-sm">
            <div class="container">
                <a class="navbar-brand d-flex align-items-center py-1" href="@Url.Content("~/")" aria-label="Mi Liga">
                    <img data-brand="logo-nav"
                         src="~/branding/blue/logo-dark.svg"
                         asp-append-version="true"
                         alt="Mi Liga"
                         class="miliga-brand-logo" />
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#miligaNavbar"
                        aria-controls="miligaNavbar" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse" id="miligaNavbar">
                    <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                        <li class="nav-item">
                            <a class="nav-link" href="@Url.Content("~/")">Inicio</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="@Url.Content("~/ligas")">Ligas</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="@Url.Content("~/precios")">Precios</a>
                        </li>
                    </ul>
                    <ul class="navbar-nav align-items-lg-center gap-lg-2">
                        <li class="nav-item">
                            <a class="btn btn-outline-light btn-sm" href="@Url.Content("~/login")">Iniciar sesión</a>
                        </li>
                        <li class="nav-item">
                            <a class="btn btn-warning btn-sm fw-bold" href="@Url.Content("~/login")">Crear liga</a>
                        </li>
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <div class="container flex-grow-1 mb-5 mt-4">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="miliga-footer border-top footer mt-auto py-3">
        <div class="container text-center">
            &copy; @DateTime.Now.Year - Mi Liga - <a href="https://miliga.com.ar" class="text-decoration-none">miliga.com.ar</a>
        </div>
    </footer>

    <!-- Bootstrap JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js" integrity="sha384-C6RzsynM9kWDrMNeT87bh95OGNyZPhcTNXj1NW7RuBCsyN/o0jlpcV8Qyq46cDfL" crossorigin="anonymous"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
