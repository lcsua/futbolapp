@{
    Layout = "~/Views/Shared/V2/_V2Layout.cshtml";
    PublicWeb.Seo.SeoPageApplicator.Apply(PublicWeb.Seo.SeoCopy.NotFound(), ViewData, ViewBag);
}

<section>
    <p class="v2-page-lead" style="text-transform:uppercase;letter-spacing:0.06em;font-size:0.75rem;font-weight:600">Ups</p>
    <h1 class="v2-page-title">Seguimos creciendo</h1>
    <p class="v2-page-lead" style="margin-bottom: var(--space-6, 1.5rem); max-width: 34rem;">
        Todavía estamos en proceso de desarrollo y expansión. La página que buscás no está disponible por ahora,
        pero el resto de Mi Liga sigue a un clic.
    </p>
    <p style="display:flex;flex-wrap:wrap;gap:0.75rem">
        <a class="v2-button" href="@Url.Content("~/")">Ir al inicio</a>
        <a class="v2-more-link" href="@Url.Content("~/ligas")">Ver ligas →</a>
    </p>
</section>
