@model PublicWeb.Models.Public.TeamDetailViewModel
@{
    var league = Model.League ?? ViewBag.League as PublicWeb.Models.Public.LeagueViewModel;
    var seasons = ViewBag.Seasons as List<PublicWeb.Models.Public.SeasonViewModel>;
    var leagueSlug = league?.Slug ?? string.Empty;
    ViewData["Title"] = Model.Team.Name + (league != null ? $" - {league.Name}" : string.Empty);
    var hasLogo = !string.IsNullOrWhiteSpace(Model.Team.LogoUrl);
    var standing = Model.Standing;
    var seasonQuery = Model.Season?.Slug ?? string.Empty;
    var teamPageBase = Url.Content($"~/ligas/{leagueSlug}/{Model.Team.Slug}");
    var teamPageJson = Url.Content($"~/ligas/{leagueSlug}/{Model.Team.Slug}/pagina");
}

<div class="mb-3">
    <a href="@Url.Content($"~/ligas/{leagueSlug}")" class="text-decoration-none small text-muted">← @league?.Name</a>
</div>

<div class="card mb-3 shadow-sm border-0 bg-white league-page-header">
    <div class="card-body">
        <div class="d-flex align-items-center gap-3">
            @if (hasLogo)
            {
                <img src="@Model.Team.LogoUrl" alt="@Model.Team.Name" class="team-crest" width="72" height="72" />
            }
            else
            {
                <div class="team-crest-placeholder">@GetInitials(Model.Team.Name)</div>
            }
            <div>
                <h1 class="h2 fw-bold mb-1">@Model.Team.Name</h1>
                @if (!string.IsNullOrWhiteSpace(Model.Team.ShortName))
                {
                    <p class="text-muted mb-0 small">@Model.Team.ShortName</p>
                }
                @if (!string.IsNullOrWhiteSpace(standing?.DivisionName))
                {
                    <p class="text-muted mb-0 small">@standing.DivisionName · @(Model.Season?.Name)</p>
                }
                else if (Model.Season != null)
                {
                    <p class="text-muted mb-0 small">@Model.Season.Name</p>
                }
            </div>
        </div>
    </div>
</div>

@if (seasons != null && seasons.Count > 1)
{
    <form method="get" class="mb-3 d-flex align-items-center bg-white rounded shadow-sm flex-wrap league-filters">
        <div class="d-flex align-items-center me-3 mb-1 mb-md-0">
            <label class="me-2 fw-semibold small text-dark mb-0">Temporada:</label>
            <select name="season" class="form-select w-auto" onchange="this.form.submit()">
                @foreach (var s in seasons)
                {
                    if (Model.Season != null && Model.Season.Slug == s.Slug)
                    {
                        <option value="@s.Slug" selected>@s.Name</option>
                    }
                    else
                    {
                        <option value="@s.Slug">@s.Name</option>
                    }
                }
            </select>
        </div>
    </form>
}

@if (standing != null)
{
    <div class="row g-3 mb-3">
        <div class="col-6 col-md-3">
            <div class="card border-0 shadow-sm text-center h-100 team-stat-card">
                <div class="card-body py-3">
                    <div class="text-muted small text-uppercase">Posición</div>
                    <div class="display-6 fw-bold text-primary mb-0">@standing.Position°</div>
                </div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="card border-0 shadow-sm text-center h-100 team-stat-card">
                <div class="card-body py-3">
                    <div class="text-muted small text-uppercase">Puntos</div>
                    <div class="display-6 fw-bold mb-0">@standing.Points</div>
                </div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="card border-0 shadow-sm text-center h-100 team-stat-card">
                <div class="card-body py-3">
                    <div class="text-muted small text-uppercase">PJ</div>
                    <div class="h3 fw-bold mb-0">@standing.Played</div>
                    <div class="small text-muted">@standing.Wins PG · @standing.Draws PE · @standing.Losses PP</div>
                </div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="card border-0 shadow-sm text-center h-100 team-stat-card">
                <div class="card-body py-3">
                    <div class="text-muted small text-uppercase">DG</div>
                    <div class="h3 fw-bold mb-0">@(standing.GoalDifference > 0 ? $"+{standing.GoalDifference}" : standing.GoalDifference.ToString())</div>
                    <div class="small text-muted">@standing.GoalsFor GF · @standing.GoalsAgainst GC</div>
                </div>
            </div>
        </div>
    </div>
}

<div class="row g-3"
     id="team-matches"
     data-endpoint="@teamPageJson"
     data-page-base="@teamPageBase"
     data-season="@seasonQuery"
     data-next-page="@Model.NextMatchesPage"
     data-results-page="@Model.LastResultsPage"
     data-match-base="@Url.Content("~/partido/")">
    <div class="col-md-6">
        <div class="card shadow-sm border-0 h-100">
            <div class="card-header bg-white d-flex justify-content-between align-items-center">
                <span class="fw-bold">Últimos resultados</span>
                <span class="small text-muted" data-role="results-total">
                    @if (Model.LastResultsTotal > 0)
                    {
                        @($"{Model.LastResultsTotal} en total")
                    }
                </span>
            </div>
            <div class="card-body p-0" data-role="results-body">
                @await Html.PartialAsync("~/Views/Public/_TeamMatchList.cshtml", new PublicWeb.Models.Public.TeamMatchListPartialViewModel
                {
                    Matches = Model.LastResults,
                    Mode = "results",
                    Page = Model.LastResultsPage,
                    TotalPages = Model.LastResultsTotalPages,
                    EmptyText = "Sin resultados recientes."
                })
            </div>
        </div>
    </div>
    <div class="col-md-6">
        <div class="card shadow-sm border-0 h-100">
            <div class="card-header bg-white d-flex justify-content-between align-items-center">
                <span class="fw-bold">Próximos partidos</span>
                <span class="small text-muted" data-role="next-total">
                    @if (Model.NextMatchesTotal > 0)
                    {
                        @($"{Model.NextMatchesTotal} en total")
                    }
                </span>
            </div>
            <div class="card-body p-0" data-role="next-body">
                @await Html.PartialAsync("~/Views/Public/_TeamMatchList.cshtml", new PublicWeb.Models.Public.TeamMatchListPartialViewModel
                {
                    Matches = Model.NextMatches,
                    Mode = "next",
                    Page = Model.NextMatchesPage,
                    TotalPages = Model.NextMatchesTotalPages,
                    EmptyText = "Sin partidos próximos."
                })
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
(() => {
  const root = document.getElementById('team-matches');
  if (!root) return;

  const endpoint = root.dataset.endpoint;
  const pageBase = root.dataset.pageBase;
  const season = root.dataset.season || '';
  const matchBase = root.dataset.matchBase || '/partido/';
  let nextPage = Number(root.dataset.nextPage || 1);
  let resultsPage = Number(root.dataset.resultsPage || 1);
  let loading = false;

  const escapeHtml = (value) => String(value ?? '')
    .replace(/&/g, '&amp;')
    .replace(/</g, '&lt;')
    .replace(/>/g, '&gt;')
    .replace(/"/g, '&quot;')
    .replace(/'/g, '&#39;');

  const formatDate = (iso) => {
    const d = new Date(iso);
    if (Number.isNaN(d.getTime())) return '';
    const dd = String(d.getDate()).padStart(2, '0');
    const mm = String(d.getMonth() + 1).padStart(2, '0');
    return `${dd}/${mm}`;
  };

  const formatTime = (iso) => {
    const d = new Date(iso);
    if (Number.isNaN(d.getTime())) return '—';
    const hh = String(d.getHours()).padStart(2, '0');
    const mi = String(d.getMinutes()).padStart(2, '0');
    return `${hh}:${mi}`;
  };

  const renderMatches = (matches, mode) => {
    if (!matches || matches.length === 0) {
      const empty = mode === 'next' ? 'Sin partidos próximos.' : 'Sin resultados recientes.';
      return `<div class="p-4 text-center text-muted small">${empty}</div>`;
    }

    const rows = matches.map((m) => {
      const field = (mode === 'next' && m.fieldName)
        ? `<div class="match-field text-center mt-1">${escapeHtml(m.fieldName)}</div>`
        : '';
      const center = mode === 'next'
        ? `<div class="league-match-meta text-muted">${escapeHtml(formatDate(m.kickoff))}</div>
           <div class="match-time">${escapeHtml(formatTime(m.kickoff))}</div>`
        : `<div class="league-match-meta text-muted">${escapeHtml(formatDate(m.kickoff))}</div>` +
          (String(m.status || '').toUpperCase() === 'SUSPENDED'
            ? `<div class="match-score text-warning">Suspendido</div>`
            : `<div class="match-score">${escapeHtml(m.homeScore ?? '')} - ${escapeHtml(m.awayScore ?? '')}</div>`);
      return `
        <a href="${escapeHtml(matchBase)}${escapeHtml(m.slug || m.id)}" class="list-group-item list-group-item-action">
          <div class="row align-items-center g-2 league-match-row">
            <div class="col-5">
              <div class="text-end text-truncate match-team" title="${escapeHtml(m.homeTeam)}">${escapeHtml(m.homeTeam)}</div>
            </div>
            <div class="col-2 text-center">
              ${center}
            </div>
            <div class="col-5">
              <div class="text-start text-truncate match-team" title="${escapeHtml(m.awayTeam)}">${escapeHtml(m.awayTeam)}</div>
            </div>
          </div>
          ${field}
        </a>`;
    }).join('');

    return `<div class="list-group list-group-flush league-match-list">${rows}</div>`;
  };

  const renderPager = (page, totalPages, kind) => {
    if (totalPages <= 1) return '';
    const prevDisabled = page <= 1;
    const nextDisabled = page >= totalPages;
    return `
      <div class="d-flex justify-content-between align-items-center px-3 py-2 border-top team-pager">
        <button type="button" class="btn btn-sm btn-outline-secondary" data-page-kind="${kind}" data-page-dir="-1"${prevDisabled ? ' disabled' : ''}>← Anteriores</button>
        <span class="small text-muted">Pág. ${page} / ${totalPages}</span>
        <button type="button" class="btn btn-sm btn-outline-secondary" data-page-kind="${kind}" data-page-dir="1"${nextDisabled ? ' disabled' : ''}>Siguientes →</button>
      </div>`;
  };

  const syncUrl = () => {
    const params = new URLSearchParams();
    if (season) params.set('season', season);
    if (nextPage > 1) params.set('nextPage', String(nextPage));
    if (resultsPage > 1) params.set('resultsPage', String(resultsPage));
    const qs = params.toString();
    history.replaceState(null, '', qs ? `${pageBase}?${qs}` : pageBase);
  };

  const applyData = (data) => {
    nextPage = data.nextMatchesPage;
    resultsPage = data.lastResultsPage;
    root.dataset.nextPage = String(nextPage);
    root.dataset.resultsPage = String(resultsPage);

    const nextBody = root.querySelector('[data-role="next-body"]');
    const resultsBody = root.querySelector('[data-role="results-body"]');
    const nextTotal = root.querySelector('[data-role="next-total"]');
    const resultsTotal = root.querySelector('[data-role="results-total"]');

    if (nextBody) {
      nextBody.innerHTML = renderMatches(data.nextMatches, 'next') + renderPager(data.nextMatchesPage, data.nextMatchesTotalPages, 'next');
    }
    if (resultsBody) {
      resultsBody.innerHTML = renderMatches(data.lastResults, 'results') + renderPager(data.lastResultsPage, data.lastResultsTotalPages, 'results');
    }
    if (nextTotal) {
      nextTotal.textContent = data.nextMatchesTotal > 0 ? `${data.nextMatchesTotal} en total` : '';
    }
    if (resultsTotal) {
      resultsTotal.textContent = data.lastResultsTotal > 0 ? `${data.lastResultsTotal} en total` : '';
    }
    syncUrl();
  };

  const loadPage = async (next, results) => {
    if (loading) return;
    loading = true;
    root.classList.add('is-paging');
    try {
      const params = new URLSearchParams({
        nextPage: String(next),
        resultsPage: String(results)
      });
      if (season) params.set('season', season);
      const res = await fetch(`${endpoint}?${params.toString()}`, {
        headers: { 'Accept': 'application/json' }
      });
      if (!res.ok) throw new Error('No se pudo cargar la página');
      const data = await res.json();
      applyData(data);
    } catch (err) {
      console.error(err);
    } finally {
      loading = false;
      root.classList.remove('is-paging');
    }
  };

  root.addEventListener('click', (event) => {
    const btn = event.target.closest('[data-page-kind]');
    if (!btn || btn.disabled) return;
    event.preventDefault();
    const kind = btn.dataset.pageKind;
    const dir = Number(btn.dataset.pageDir || 0);
    if (kind === 'next') {
      loadPage(nextPage + dir, resultsPage);
    } else if (kind === 'results') {
      loadPage(nextPage, resultsPage + dir);
    }
  });
})();
</script>
}

@functions {
    private static string GetInitials(string name)
    {
        if (string.IsNullOrWhiteSpace(name)) return "?";
        var parts = name.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        if (parts.Length == 1) return parts[0].Substring(0, Math.Min(2, parts[0].Length)).ToUpperInvariant();
        return $"{parts[0][0]}{parts[^1][0]}".ToUpperInvariant();
    }
}
