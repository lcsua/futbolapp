@model PublicWeb.Models.Public.LeagueViewModel
@{
    ViewData["Title"] = Model.Name;
    ViewBag.League = Model;
}

<div class="mb-3">
    <a href="@Url.Content("~/ligas")" class="text-decoration-none small text-muted">← Todas las ligas</a>
</div>

<div class="card mb-4 shadow-sm border-0 bg-white">
    <div class="card-body py-4">
        <h2 class="fw-bold mb-1">@Model.Name</h2>
        <p class="text-muted mb-0"><i class="bi bi-geo-alt"></i> @Model.Country</p>
    </div>
</div>

@await Html.PartialAsync("~/Views/Public/_LeagueNavTabs.cshtml")

<div class="card shadow-sm mb-4">
    <div class="card-header bg-white fw-bold">Acerca de la liga</div>
    <div class="card-body">
        <p>@Model.Description</p>
        <div class="alert alert-info">Seguí el torneo de @Model.Name: tabla de posiciones, resultados y próximos partidos.</div>
    </div>
</div>
