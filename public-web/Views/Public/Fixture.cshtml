@model PublicWeb.Models.Public.SeasonGroupedViewModel<PublicWeb.Models.Public.MatchdayGroupViewModel>
@{
    var league = ViewBag.League as PublicWeb.Models.Public.LeagueViewModel;
    var seasons = ViewBag.Seasons as List<PublicWeb.Models.Public.SeasonViewModel>;
    
    var selectedSeason = seasons?.FirstOrDefault(s => Model != null && Model.SeasonSlug == s.Slug) ?? seasons?.FirstOrDefault();
    var divisions = selectedSeason?.Divisions ?? new();
    
    ViewData["Title"] = "Fixture - " + league?.Name;
}

<div class="mb-3">
    <a href="@Url.Content("~/ligas")" class="text-decoration-none small text-muted">← Todas las ligas</a>
</div>

<div class="card mb-3 shadow-sm border-0 bg-white league-page-header">
    <div class="card-body">
        <h2 class="fw-bold mb-1">@league?.Name</h2>
        <p class="text-muted mb-0 small">@league?.Country</p>
    </div>
</div>

@await Html.PartialAsync("~/Views/Public/_LeagueNavTabs.cshtml")

@if (seasons != null && seasons.Any())
{
    <form method="get" class="mb-3 d-flex align-items-center bg-white rounded shadow-sm flex-wrap league-filters">
        <div class="d-flex align-items-center me-3 mb-1 mb-md-0">
            <label class="me-2 fw-semibold small text-dark mb-0">Temporada:</label>
            <select name="season" class="form-select w-auto" onchange="this.form.submit()">
                @foreach (var s in seasons)
                {
                    if (Model != null && Model.SeasonSlug == s.Slug)
                    {
                        <option value="@s.Slug" selected>@s.Name</option>
                    }
                    else
                    {
                        <option value="@s.Slug">@s.Name</option>
                    }
                }
            </select>
        </div>
        
        <div class="d-flex align-items-center mb-1 mb-md-0">
            <label class="me-2 fw-semibold small text-dark mb-0">División:</label>
            <select name="division" class="form-select w-auto" onchange="this.form.submit()">
                <option value="all">Todas</option>
                @foreach (var d in divisions)
                {
                    if (ViewBag.Division != null && ViewBag.Division == d.Slug)
                    {
                        <option value="@d.Slug" selected>@d.Name</option>
                    }
                    else
                    {
                        <option value="@d.Slug">@d.Name</option>
                    }
                }
            </select>
        </div>
    </form>
}

@if (Model != null && Model.Divisions.Any())
{
    foreach (var div in Model.Divisions)
    {
        <h3 class="h6 fw-bold mt-3 mb-2 text-secondary">@div.DivisionName</h3>
        
        @if (div.Data != null && div.Data.Any())
        {
            var requestingRound = ViewBag.Round as int?;
            var activeMatchday = requestingRound.HasValue
                ? div.Data.FirstOrDefault(m => m.Round == requestingRound)
                : (div.DefaultRound.HasValue
                    ? div.Data.FirstOrDefault(m => m.Round == div.DefaultRound.Value)
                    : null);
            if (activeMatchday == null) activeMatchday = div.Data.FirstOrDefault();

            var currentRoundNav = activeMatchday?.Round;

            <ul class="nav nav-pills mb-2 overflow-auto flex-nowrap pb-1 round-pills" style="white-space: nowrap;">
                @foreach (var matchday in div.Data)
                {
                    <li class="nav-item me-1">
                        <a class="nav-link rounded-pill @(matchday.Round == currentRoundNav ? "active" : "bg-light text-dark border")" 
                           href="?season=@Model.SeasonSlug&division=@(ViewBag.Division)&round=@matchday.Round">
                           Fecha @matchday.Round
                        </a>
                    </li>
                }
            </ul>

            <div class="card shadow-sm mb-3 border-0">
                <div class="card-body p-0">
                    @if (activeMatchday != null && activeMatchday.Matches.Any())
                    {
                        <div class="list-group list-group-flush league-match-list">
                        @foreach (var match in activeMatchday.Matches)
                        {
                            <div class="list-group-item">
                                <div class="row align-items-center g-2 league-match-row">
                                    <div class="col-5">
                                        <div class="text-end text-truncate match-team" title="@match.HomeTeam.Name">
                                            @if (!string.IsNullOrWhiteSpace(match.HomeTeam.Slug))
                                            {
                                                <a href="@Url.Content($"~/ligas/{league?.Slug}/{match.HomeTeam.Slug}")" class="text-decoration-none text-dark">@match.HomeTeam.Name</a>
                                            }
                                            else
                                            {
                                                @match.HomeTeam.Name
                                            }
                                        </div>
                                    </div>
                                    <div class="col-2 text-center">
                                        @if (string.Equals(match.Status, "SUSPENDED", StringComparison.OrdinalIgnoreCase))
                                        {
                                            <div class="match-time text-warning fw-semibold">Suspendido</div>
                                            <div class="league-match-meta text-muted">@match.Kickoff.ToString("dd/MM")</div>
                                        }
                                        else
                                        {
                                            <div class="match-time">@match.Kickoff.ToString("HH:mm")</div>
                                            <div class="league-match-meta text-muted">@match.Kickoff.ToString("dd/MM")</div>
                                        }
                                    </div>
                                    <div class="col-5">
                                        <div class="text-start text-truncate match-team" title="@match.AwayTeam.Name">
                                            @if (!string.IsNullOrWhiteSpace(match.AwayTeam.Slug))
                                            {
                                                <a href="@Url.Content($"~/ligas/{league?.Slug}/{match.AwayTeam.Slug}")" class="text-decoration-none text-dark">@match.AwayTeam.Name</a>
                                            }
                                            else
                                            {
                                                @match.AwayTeam.Name
                                            }
                                        </div>
                                    </div>
                                </div>
                            </div>
                        }
                        </div>
                    }
                    else
                    {
                        <div class="p-4 text-center text-muted small">
                            No hay partidos programados en esta fecha.
                        </div>
                    }
                </div>
            </div>
        }
        else
        {
            <div class="p-3 text-center text-muted small">
                No hay partidos registrados en esta división.
            </div>
        }
    }
}
else
{
    <div class="card shadow-sm border-0">
        <div class="p-4 text-center text-muted small">No hay partidos registrados.</div>
    </div>
}
