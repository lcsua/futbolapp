@model PublicWeb.Models.Public.SeasonGroupedViewModel<PublicWeb.Models.Public.StandingsRowViewModel>
@{
    var league = ViewBag.League as PublicWeb.Models.Public.LeagueViewModel;
    var seasons = ViewBag.Seasons as List<PublicWeb.Models.Public.SeasonViewModel>;
    
    var selectedSeason = seasons?.FirstOrDefault(s => Model != null && Model.SeasonSlug == s.Slug) ?? seasons?.FirstOrDefault();
    var divisions = selectedSeason?.Divisions ?? new();
    
    ViewData["Title"] = "Tabla de posiciones - " + league?.Name;
}

<div class="mb-3">
    <a href="@Url.Content("~/ligas")" class="text-decoration-none small text-muted">← Todas las ligas</a>
</div>

<div class="card mb-3 shadow-sm border-0 bg-white league-page-header">
    <div class="card-body">
        <h2 class="fw-bold mb-1">@league?.Name</h2>
        <p class="text-muted mb-0 small">@league?.Country</p>
    </div>
</div>

<ul class="nav nav-pills mb-3 nav-fill bg-white p-2 border rounded shadow-sm">
    <li class="nav-item">
        <a class="nav-link text-dark" href="@Url.Content($"~/ligas/{league?.Slug}")">Resumen</a>
    </li>
    <li class="nav-item">
        <a class="nav-link active fw-bold" href="@Url.Content($"~/ligas/{league?.Slug}/tabla")">Tabla de posiciones</a>
    </li>
    <li class="nav-item">
        <a class="nav-link text-dark" href="@Url.Content($"~/ligas/{league?.Slug}/resultados")">Resultados</a>
    </li>
    <li class="nav-item">
        <a class="nav-link text-dark" href="@Url.Content($"~/ligas/{league?.Slug}/partidos")">Próximos partidos</a>
    </li>
</ul>

@if (seasons != null && seasons.Any())
{
    <form method="get" class="mb-3 d-flex align-items-center bg-white rounded shadow-sm flex-wrap league-filters">
        <div class="d-flex align-items-center me-3 mb-1 mb-md-0">
            <label class="me-2 fw-semibold small text-dark mb-0">Temporada:</label>
            <select name="season" class="form-select w-auto" onchange="this.form.submit()">
                @foreach (var s in seasons)
                {
                    if (Model != null && Model.SeasonSlug == s.Slug)
                    {
                        <option value="@s.Slug" selected>@s.Name</option>
                    }
                    else
                    {
                        <option value="@s.Slug">@s.Name</option>
                    }
                }
            </select>
        </div>
        
        <div class="d-flex align-items-center mb-1 mb-md-0">
            <label class="me-2 fw-semibold small text-dark mb-0">División:</label>
            <select name="division" class="form-select w-auto" onchange="this.form.submit()">
                <option value="all">Todas</option>
                @foreach (var d in divisions)
                {
                    if (ViewBag.Division != null && ViewBag.Division == d.Slug)
                    {
                        <option value="@d.Slug" selected>@d.Name</option>
                    }
                    else
                    {
                        <option value="@d.Slug">@d.Name</option>
                    }
                }
            </select>
        </div>
    </form>
}

@if (Model != null && Model.Divisions.Any())
{
    foreach (var div in Model.Divisions)
    {
        <h3 class="h6 fw-bold mt-3 mb-2 text-secondary">@div.DivisionName</h3>
        <div class="card shadow-sm mb-3 border-0 standings-card">
            <div class="card-body p-0">
                <div class="table-responsive standings-scroll">
                    <table class="table table-striped table-hover mb-0 align-middle standings-table">
                        <thead class="table-light">
                            <tr>
                                <th scope="col" class="text-center standings-pos">#</th>
                                <th scope="col" class="text-start">Equipo</th>
                                <th scope="col" class="text-center" title="Partidos Jugados">PJ</th>
                                <th scope="col" class="text-center d-none d-sm-table-cell" title="Partidos Ganados">PG</th>
                                <th scope="col" class="text-center d-none d-sm-table-cell" title="Partidos Empatados">PE</th>
                                <th scope="col" class="text-center d-none d-sm-table-cell" title="Partidos Perdidos">PP</th>
                                <th scope="col" class="text-center d-none d-md-table-cell" title="Goles a Favor">GF</th>
                                <th scope="col" class="text-center d-none d-md-table-cell" title="Goles en Contra">GC</th>
                                <th scope="col" class="text-center" title="Diferencia de Gol">DG</th>
                                <th scope="col" class="text-center fw-bold standings-pts" title="Puntos">Pts</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (div.Data != null && div.Data.Any())
                            {
                                foreach (var row in div.Data)
                                {
                                    var fullName = row.Team.Name;
                                    var shortName = GetMobileTeamName(row.Team);
                                    <tr>
                                        <td class="text-center fw-semibold standings-pos">@row.Position</td>
                                        <td class="text-start standings-team">
                                            <a href="@Url.Content($"~/ligas/{league?.Slug}/{row.Team.Slug}")"
                                               class="standings-team-link"
                                               title="@fullName">
                                                <span class="d-none d-md-inline">@fullName</span>
                                                <span class="d-md-none">@shortName</span>
                                            </a>
                                        </td>
                                        <td class="text-center">@row.Played</td>
                                        <td class="text-center d-none d-sm-table-cell">@row.Won</td>
                                        <td class="text-center d-none d-sm-table-cell">@row.Drawn</td>
                                        <td class="text-center d-none d-sm-table-cell">@row.Lost</td>
                                        <td class="text-center d-none d-md-table-cell">@row.GoalsFor</td>
                                        <td class="text-center d-none d-md-table-cell">@row.GoalsAgainst</td>
                                        <td class="text-center">@(row.GoalDifference > 0 ? $"+{row.GoalDifference}" : row.GoalDifference.ToString())</td>
                                        <td class="text-center fw-bold text-primary standings-pts">@row.Points</td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="10" class="text-center p-3 text-muted small">Aún no hay datos de posiciones.</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    }
}
else
{
    <div class="card shadow-sm border-0">
        <div class="card-body p-5 text-center text-muted">Aún no hay datos de posiciones registrados.</div>
    </div>
}

@functions {
    private static readonly HashSet<string> SkipWords = new(StringComparer.OrdinalIgnoreCase)
    {
        "de", "del", "la", "las", "los", "el", "y", "a", "en", "por"
    };

    private static string GetMobileTeamName(PublicWeb.Models.Public.TeamViewModel team)
    {
        if (!string.IsNullOrWhiteSpace(team.ShortName))
            return team.ShortName.Trim();

        var name = team.Name?.Trim() ?? string.Empty;
        if (string.IsNullOrEmpty(name))
            return name;

        var parts = name.Split(' ', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);
        if (parts.Length <= 1)
            return name;

        var meaningful = parts.Where(p => !SkipWords.Contains(p)).ToArray();
        var lastWord = meaningful.Length > 0 ? meaningful[^1] : parts[^1];
        var firstWord = parts[0];

        // Same token → nothing to abbreviate
        if (string.Equals(firstWord, lastWord, StringComparison.OrdinalIgnoreCase))
            return lastWord;

        var initial = char.ToUpperInvariant(firstWord[0]);
        // "Jueves de Sometidos" → "J.Sometidos", "Barrio Oeste" → "B.Oeste"
        return $"{initial}.{lastWord}";
    }
}
