@{
    var leagueSlug = ViewBag.LeagueSlug as string
        ?? (ViewBag.League as PublicWeb.Models.Public.LeagueViewModel)?.Slug;
    var active = ViewBag.ActiveLeagueTab as string ?? "resumen";
    var categories = ViewBag.DocumentCategories as List<PublicWeb.Models.Public.LeagueDocumentCategoryViewModel>
        ?? new List<PublicWeb.Models.Public.LeagueDocumentCategoryViewModel>();
}

@if (!string.IsNullOrWhiteSpace(leagueSlug))
{
    <ul class="nav nav-pills mb-3 nav-fill bg-white p-2 border rounded shadow-sm league-nav-tabs">
        <li class="nav-item">
            <a class="nav-link @(active == "resumen" ? "active fw-bold" : "text-dark")" href="@Url.Content($"~/ligas/{leagueSlug}")">Resumen</a>
        </li>
        <li class="nav-item">
            <a class="nav-link @(active == "tabla" ? "active fw-bold" : "text-dark")" href="@Url.Content($"~/ligas/{leagueSlug}/tabla")">Tabla de posiciones</a>
        </li>
        <li class="nav-item">
            <a class="nav-link @(active == "resultados" ? "active fw-bold" : "text-dark")" href="@Url.Content($"~/ligas/{leagueSlug}/resultados")">Resultados</a>
        </li>
        <li class="nav-item">
            <a class="nav-link @(active == "partidos" ? "active fw-bold" : "text-dark")" href="@Url.Content($"~/ligas/{leagueSlug}/partidos")">Próximos partidos</a>
        </li>
        @foreach (var cat in categories)
        {
            var key = $"doc:{cat.Slug}";
            <li class="nav-item">
                <a class="nav-link @(active == key ? "active fw-bold" : "text-dark")" href="@Url.Content($"~/ligas/{leagueSlug}/documentos/{cat.Slug}")">@cat.Name</a>
            </li>
        }
    </ul>
}
