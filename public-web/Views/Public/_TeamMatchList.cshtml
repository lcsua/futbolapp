@model PublicWeb.Models.Public.TeamMatchListPartialViewModel
@{
    var kind = Model.Mode == "results" ? "results" : "next";
}

@if (Model.Matches.Any())
{
    <div class="list-group list-group-flush league-match-list">
        @foreach (var match in Model.Matches)
        {
            <a href="@Url.Content(MatchSlugHelper.AppRelative(match))" class="list-group-item list-group-item-action">
                <div class="row align-items-center g-2 league-match-row">
                    <div class="col-5">
                        <div class="text-end text-truncate match-team" title="@match.HomeTeam.Name">@match.HomeTeam.Name</div>
                    </div>
                    <div class="col-2 text-center">
                        @if (kind == "next")
                        {
                            <div class="league-match-meta text-muted">@match.Kickoff.ToString("dd/MM")</div>
                            <div class="match-time">@(match.Kickoff == default ? "—" : match.Kickoff.ToString("HH:mm"))</div>
                        }
                        else
                        {
                            <div class="league-match-meta text-muted">@match.Kickoff.ToString("dd/MM")</div>
                            @if (string.Equals(match.Status, "SUSPENDED", StringComparison.OrdinalIgnoreCase))
                            {
                                <div class="match-score text-warning">Suspendido</div>
                            }
                            else
                            {
                                <div class="match-score">@match.HomeScore - @match.AwayScore</div>
                            }
                        }
                    </div>
                    <div class="col-5">
                        <div class="text-start text-truncate match-team" title="@match.AwayTeam.Name">@match.AwayTeam.Name</div>
                    </div>
                </div>
                @if (kind == "next" && !string.IsNullOrWhiteSpace(match.FieldName))
                {
                    <div class="match-field text-center mt-1">@match.FieldName</div>
                }
            </a>
        }
    </div>
    @if (Model.TotalPages > 1)
    {
        <div class="d-flex justify-content-between align-items-center px-3 py-2 border-top team-pager">
            <button type="button"
                    class="btn btn-sm btn-outline-secondary"
                    data-page-kind="@kind"
                    data-page-dir="-1"
                    @(Model.Page <= 1 ? "disabled" : null)>← Anteriores</button>
            <span class="small text-muted">Pág. @Model.Page / @Model.TotalPages</span>
            <button type="button"
                    class="btn btn-sm btn-outline-secondary"
                    data-page-kind="@kind"
                    data-page-dir="1"
                    @(Model.Page >= Model.TotalPages ? "disabled" : null)>Siguientes →</button>
        </div>
    }
}
else
{
    <div class="p-4 text-center text-muted small">@Model.EmptyText</div>
}
