@using System.Linq
@model PublicWeb.Models.Public.LeagueHomeViewModel
@{
    Layout = "~/Views/Shared/V2/_V2Layout.cshtml";
    ViewBag.LeagueDetails = true;
    var league = Model.League;
    var leagueSlug = league.Slug;
    var seasons = ViewBag.Seasons as List<PublicWeb.Models.Public.SeasonViewModel>;
    var seasonQs = string.IsNullOrWhiteSpace(Model.SeasonSlug)
        ? ""
        : $"season={Uri.EscapeDataString(Model.SeasonSlug)}";
    string WithSeason(string path, string extra)
    {
        var parts = new[] { seasonQs, extra }.Where(x => !string.IsNullOrWhiteSpace(x));
        var q = string.Join("&", parts);
        return string.IsNullOrEmpty(q) ? path : path + "?" + q;
    }

    ViewData["Title"] = league.Name;
    ViewData["Description"] = string.IsNullOrWhiteSpace(league.Description)
        ? $"Portada de {league.Name}."
        : league.Description;
    ViewBag.PageLabel = "Resumen";
    ViewBag.SeasonName = Model.SeasonName;
    ViewBag.SeasonSlug = Model.SeasonSlug;
    ViewBag.LeagueSlug = leagueSlug;
    ViewBag.League = league;
    ViewData["LeagueSlug"] = leagueSlug;
    ViewData["BadgeSize"] = "sm";

    PublicWeb.Seo.SeoPageApplicator.Apply(
        PublicWeb.Seo.SeoCopy.LeagueHome(league.Name, leagueSlug, Model.SeasonName, league.LogoUrl, league.Description),
        ViewData,
        ViewBag);

    var panels = Model.DivisionPanels ?? new List<PublicWeb.Models.Public.LeagueHomeDivisionPanelViewModel>();
    var selectedSlug = Model.SelectedDivisionSlug;
}

@await Html.PartialAsync("~/Views/V2/League/_LeagueBackNav.cshtml")

@await Html.PartialAsync("~/Views/V2/League/_LeagueHeader.cshtml", league)

@await Html.PartialAsync("~/Views/V2/League/_CompetitionTabs.cshtml")

@if (seasons != null && seasons.Count > 1)
{
    <form method="get" class="v2-filter-bar v2-filter-bar--compact" aria-label="Filtro de temporada">
        <div class="v2-filter-bar__group">
            <label for="v2-filter-season">Temporada</label>
            <select id="v2-filter-season" name="season" class="v2-select" onchange="this.form.submit()">
                @foreach (var s in seasons)
                {
                    if (Model.SeasonSlug == s.Slug)
                    {
                        <option value="@s.Slug" selected>@s.Name</option>
                    }
                    else
                    {
                        <option value="@s.Slug">@s.Name</option>
                    }
                }
            </select>
        </div>
    </form>
}

@if (panels.Count > 0)
{
    <div class="v2-home-board">
        <style>
            .v2-home-board > [data-home-pane] { display: none; }
            @foreach (var panel in panels)
            {
                var inputId = PublicWeb.Helpers.LeagueHomeComposer.CssId("home-div-", panel.DivisionSlug);
                <text>
                #@inputId:checked ~ [data-home-pane="@panel.DivisionSlug"] { display: grid; }
                #@inputId:checked ~ .v2-home-divisions [data-home-chip="@panel.DivisionSlug"] {
                    background: var(--v2-primary);
                    border-color: var(--v2-primary);
                    color: #fff;
                }
                </text>
            }
        </style>

        @foreach (var panel in panels)
        {
            var inputId = PublicWeb.Helpers.LeagueHomeComposer.CssId("home-div-", panel.DivisionSlug);
            var isSelected = string.Equals(panel.DivisionSlug, selectedSlug, StringComparison.OrdinalIgnoreCase);
            <input class="v2-home-board__radio visually-hidden"
                   type="radio"
                   name="home-division"
                   id="@inputId"
                   value="@panel.DivisionSlug"
                   @(isSelected ? "checked" : null) />
        }

        <section class="v2-home-divisions" aria-label="Divisiones">
            <h2 class="v2-home-kicker">Divisiones</h2>
            <div class="v2-home-chips" role="radiogroup" aria-label="Elegir división">
                @foreach (var panel in panels)
                {
                    var inputId = PublicWeb.Helpers.LeagueHomeComposer.CssId("home-div-", panel.DivisionSlug);
                    <label class="v2-chip v2-home-chip"
                           data-home-chip="@panel.DivisionSlug"
                           for="@inputId">@panel.DivisionName</label>
                }
            </div>
            <p class="v2-home-divisions__hint">
                <span class="v2-ui-icon v2-ui-icon--status-info v2-ui-icon--sm" aria-hidden="true"></span>
                El contenido del resumen se actualiza según la división seleccionada.
            </p>
        </section>

        @foreach (var panel in panels)
        {
            var fixtureHref = WithSeason(Url.Content($"~/ligas/{leagueSlug}/fixture")!, $"division={Uri.EscapeDataString(panel.DivisionSlug)}");
            var standingsHref = WithSeason(Url.Content($"~/ligas/{leagueSlug}/posiciones")!, $"division={Uri.EscapeDataString(panel.DivisionSlug)}");
            <div class="v2-home-grid"
                 data-home-pane="@panel.DivisionSlug">
                <section class="v2-home-card"
                         aria-labelledby="home-next-@panel.DivisionSlug">
                    <header class="v2-home-card__head">
                        <h2 id="home-next-@panel.DivisionSlug" class="v2-home-card__title">
                            <span class="v2-ui-icon v2-ui-icon--calendar" aria-hidden="true"></span>
                            @(string.Equals(panel.FechaStatus, "Finalizada", StringComparison.OrdinalIgnoreCase)
                                ? "Última fecha"
                                : "Próxima fecha")
                        </h2>
                        <a class="v2-home-card__link" href="@fixtureHref">
                            Ver fixture
                            <span class="v2-ui-icon v2-ui-icon--arrow" aria-hidden="true"></span>
                        </a>
                    </header>
                    <p class="v2-home-card__sub">
                        @if (panel.Round.HasValue)
                        {
                            <span>Fecha @panel.Round.Value</span>
                        }
                        @if (panel.DisplayDate.HasValue)
                        {
                            <span aria-hidden="true">·</span>
                            <span>@PublicWeb.Helpers.TeamDisplayHelper.FormatWeekdayDayDeMonth(panel.DisplayDate.Value)</span>
                        }
                    </p>
                    @if (panel.Matches.Count > 0)
                    {
                        <div class="v2-home-card__body">
                            @foreach (var match in panel.Matches)
                            {
                                @await Html.PartialAsync("~/Views/V2/League/_HomeMatchRow.cshtml", match)
                            }
                        </div>
                        <a class="v2-home-card__more" href="@fixtureHref">
                            Ver todos los partidos
                            <span class="v2-ui-icon v2-ui-icon--arrow" aria-hidden="true"></span>
                        </a>
                    }
                    else
                    {
                        <div class="v2-empty">Todavía no hay partidos cargados para esta división.</div>
                    }
                </section>

                <div class="v2-home-grid__side">
                    <section class="v2-home-card"
                             aria-labelledby="home-table-@panel.DivisionSlug">
                        <header class="v2-home-card__head">
                            <h2 id="home-table-@panel.DivisionSlug" class="v2-home-card__title">
                                <span class="v2-ui-icon v2-ui-icon--trophy" aria-hidden="true"></span>
                                <span>Posiciones · @panel.DivisionName</span>
                            </h2>
                            <a class="v2-home-card__link" href="@standingsHref">
                                Ver tabla
                                <span class="v2-ui-icon v2-ui-icon--arrow" aria-hidden="true"></span>
                            </a>
                        </header>
                        @if (panel.StandingsPreview.Count > 0)
                        {
                            ViewData["HidePreviewTitle"] = true;
                            @await Html.PartialAsync(
                                "~/Views/V2/League/_StandingsPreview.cshtml",
                                new PublicWeb.Models.Public.StandingsPreviewGroupViewModel
                                {
                                    DivisionName = panel.DivisionName,
                                    DivisionSlug = panel.DivisionSlug,
                                    Rows = panel.StandingsPreview
                                })
                            <a class="v2-home-card__more" href="@standingsHref">
                                Ver tabla completa
                                <span class="v2-ui-icon v2-ui-icon--arrow" aria-hidden="true"></span>
                            </a>
                        }
                        else
                        {
                            <div class="v2-empty">Todavía no hay posiciones para esta división.</div>
                        }
                    </section>

                    <section class="v2-home-card v2-home-card--teams"
                             aria-labelledby="home-teams-@panel.DivisionSlug">
                        <header class="v2-home-card__head">
                            <h2 id="home-teams-@panel.DivisionSlug" class="v2-home-card__title">
                                <span class="v2-ui-icon v2-ui-icon--teams" aria-hidden="true"></span>
                                Equipos
                            </h2>
                            <a class="v2-home-card__link" href="@standingsHref">
                                Ver todos
                                <span class="v2-ui-icon v2-ui-icon--arrow" aria-hidden="true"></span>
                            </a>
                        </header>
                        @if (panel.Teams.Count > 0)
                        {
                            var previewTeams = panel.Teams.Take(8).ToList();
                            <div class="v2-team-carousel" data-v2-team-carousel>
                                <ul class="v2-team-carousel__track" data-v2-carousel-track>
                                    @foreach (var team in previewTeams)
                                    {
                                        var teamHref = !string.IsNullOrWhiteSpace(team.Slug)
                                            ? Url.Content($"~/ligas/{leagueSlug}/{team.Slug}")
                                            : null;
                                        <li class="v2-team-carousel__item">
                                            @if (teamHref != null)
                                            {
                                                <a class="v2-team-carousel__card" href="@teamHref">
                                                    @{ ViewData["BadgeSize"] = "md"; ViewData["BadgeDecorative"] = true; }
                                                    @await Html.PartialAsync("~/Views/V2/Team/_TeamBadge.cshtml", team)
                                                    <span class="v2-team-carousel__name">@team.Name</span>
                                                </a>
                                            }
                                            else
                                            {
                                                <div class="v2-team-carousel__card">
                                                    @{ ViewData["BadgeSize"] = "md"; }
                                                    @await Html.PartialAsync("~/Views/V2/Team/_TeamBadge.cshtml", team)
                                                    <span class="v2-team-carousel__name">@team.Name</span>
                                                </div>
                                            }
                                        </li>
                                    }
                                </ul>
                            </div>
                        }
                        else
                        {
                            <div class="v2-empty">Todavía no hay equipos en esta división.</div>
                        }
                    </section>
                </div>
            </div>
        }
    </div>
}
else
{
    <div class="v2-empty">Todavía no hay divisiones publicadas para esta temporada.</div>
}

<aside class="v2-follow-cta">
    <span class="v2-follow-cta__icon" aria-hidden="true">
        <span class="v2-ui-icon v2-ui-icon--bell v2-ui-icon--lg"></span>
    </span>
    <div class="v2-follow-cta__copy">
        <p class="v2-follow-cta__title">No te pierdas nada de esta liga</p>
        <p class="v2-follow-cta__text">Recibí avisos de resultados y del fixture cuando haya novedades.</p>
    </div>
    @{
        ViewData["FollowScopeType"] = "League";
        ViewData["FollowScopeId"] = league.Id;
        ViewData["FollowLabel"] = "Seguir liga";
        ViewData["FollowFollowingLabel"] = "Siguiendo";
    }
    @await Html.PartialAsync("~/Views/Shared/V2/_FollowButton.cshtml")
</aside>

@section Scripts {
    <script src="~/js/v2/team-carousel.js" asp-append-version="true"></script>
}
