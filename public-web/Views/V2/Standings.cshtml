@model PublicWeb.Models.Public.SeasonGroupedViewModel<PublicWeb.Models.Public.StandingsRowViewModel>
@{
    Layout = "~/Views/Shared/V2/_V2Layout.cshtml";
    ViewBag.LeagueDetails = true;
    ViewBag.OverlayGlobalHeader = true;
    var league = ViewBag.League as PublicWeb.Models.Public.LeagueViewModel;
    var seasons = ViewBag.Seasons as List<PublicWeb.Models.Public.SeasonViewModel>;
    var leagueSlug = league?.Slug ?? string.Empty;
    var selectedSeason = seasons?.FirstOrDefault(s => Model != null && Model.SeasonSlug == s.Slug)
        ?? seasons?.FirstOrDefault();
    var divisions = selectedSeason?.Divisions ?? new List<PublicWeb.Models.Public.DivisionViewModel>();
    var selectedDivision = ViewBag.Division as string ?? "all";

    ViewData["Title"] = "Posiciones" + (league != null ? $" · {league.Name}" : string.Empty);
    ViewData["Description"] = $"Tabla de posiciones de {league?.Name}.";
    ViewBag.PageLabel = "Posiciones";
    ViewBag.SeasonName = Model?.SeasonName ?? selectedSeason?.Name;
    ViewBag.SeasonSlug = Model?.SeasonSlug ?? selectedSeason?.Slug;
    ViewBag.LeagueSlug = leagueSlug;

    var hasStandingsRows = Model?.Divisions?.Any(d => d.Data != null && d.Data.Count > 0) == true;
    var seasonName = ViewBag.SeasonName as string;
    var seasonSlug = ViewBag.SeasonSlug as string;
    string? seoDivisionName = null;
    if (!string.Equals(selectedDivision, "all", StringComparison.OrdinalIgnoreCase))
    {
        seoDivisionName = divisions.FirstOrDefault(d => string.Equals(d.Slug, selectedDivision, StringComparison.OrdinalIgnoreCase))?.Name
            ?? Model?.Divisions?.FirstOrDefault(d => string.Equals(d.DivisionSlug, selectedDivision, StringComparison.OrdinalIgnoreCase))?.DivisionName;
    }

    if (league != null)
    {
        PublicWeb.Seo.SeoPageApplicator.Apply(
            PublicWeb.Seo.SeoCopy.LeagueStandings(league.Name, leagueSlug, seasonName, league.LogoUrl, seoDivisionName),
            ViewData,
            ViewBag);
        if (!string.IsNullOrWhiteSpace(seoDivisionName))
            ViewData["OgUrl"] = PublicWeb.Seo.PublicShareLinks.SectionPath(leagueSlug, "posiciones", seasonSlug, selectedDivision);
    }
}

@await Html.PartialAsync("~/Views/V2/League/_LeagueBackNav.cshtml")

@await Html.PartialAsync("~/Views/V2/League/_LeagueHeader.cshtml", league)

@await Html.PartialAsync("~/Views/V2/League/_CompetitionTabs.cshtml")

<div class="v2-standings-page" data-v2-standings-page>
@if (seasons != null && seasons.Any())
{
    <form method="get" class="v2-filter-bar" aria-label="Filtros de posiciones">
        <div class="v2-filter-bar__group">
            <label for="v2-filter-season">Temporada</label>
            <select id="v2-filter-season" name="season" class="v2-select" onchange="this.form.submit()">
                @foreach (var s in seasons)
                {
                    if (Model != null && Model.SeasonSlug == s.Slug)
                    {
                        <option value="@s.Slug" selected>@s.Name</option>
                    }
                    else
                    {
                        <option value="@s.Slug">@s.Name</option>
                    }
                }
            </select>
        </div>
        <div class="v2-filter-bar__group">
            <label for="v2-filter-division">División</label>
            <select id="v2-filter-division" name="division" class="v2-select" onchange="this.form.submit()">
                @if (selectedDivision == "all")
                {
                    <option value="all" selected>Todas</option>
                }
                else
                {
                    <option value="all">Todas</option>
                }
                @foreach (var d in divisions)
                {
                    if (selectedDivision == d.Slug)
                    {
                        <option value="@d.Slug" selected>@d.Name</option>
                    }
                    else
                    {
                        <option value="@d.Slug">@d.Name</option>
                    }
                }
            </select>
        </div>
    </form>
}

@if (hasStandingsRows)
{
    <div class="v2-standings-toolbar">
        <button type="button"
                class="v2-standings-expand"
                data-v2-standings-expand
                aria-pressed="false"
                aria-label="Mostrar todas las estadísticas de la tabla">
            <svg class="v2-standings-expand__icon" width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true" focusable="false">
                <rect x="3.5" y="4.5" width="17" height="15" rx="2" stroke="currentColor" stroke-width="1.75" />
                <path d="M8.5 4.5v15M15.5 4.5v15M3.5 9.5h17M3.5 14.5h17" stroke="currentColor" stroke-width="1.75" />
            </svg>
            <span data-v2-standings-expand-label>Ver todas las estadísticas</span>
        </button>
    </div>
}

@if (Model != null && Model.Divisions.Any())
{
    foreach (var div in Model.Divisions)
    {
        <section class="v2-result-group" aria-labelledby="standings-div-@div.DivisionSlug">
            <div class="v2-result-group__head">
                <div class="v2-result-group__title-row">
                    <h2 id="standings-div-@div.DivisionSlug" class="v2-result-group__division">
                        <span class="v2-result-group__division-label">División:</span>
                        <span class="v2-result-group__division-name">@div.DivisionName</span>
                    </h2>
                    @{
                        ViewData["ShareLeagueSlug"] = leagueSlug;
                        ViewData["ShareSection"] = "posiciones";
                        ViewData["ShareSeasonSlug"] = seasonSlug;
                        ViewData["ShareDivisionSlug"] = div.DivisionSlug;
                        ViewData["ShareDivisionName"] = div.DivisionName;
                        ViewData["ShareLeagueName"] = league?.Name ?? "";
                    }
                    @await Html.PartialAsync("~/Views/Shared/V2/_DivisionShareButton.cshtml")
                </div>
            </div>

            @if (div.Data != null && div.Data.Any())
            {
                ViewData["LeagueSlug"] = leagueSlug;
                @await Html.PartialAsync("~/Views/V2/Standings/_StandingsTable.cshtml", (IReadOnlyList<PublicWeb.Models.Public.StandingsRowViewModel>)div.Data)
            }
            else
            {
                <div class="v2-empty">No hay posiciones disponibles para esta selección.</div>
            }
        </section>
    }
}
else
{
    <div class="v2-empty">No hay posiciones disponibles para esta selección.</div>
}
</div>

@section Scripts {
    <script src="~/js/v2/standings.js" asp-append-version="true"></script>
}
