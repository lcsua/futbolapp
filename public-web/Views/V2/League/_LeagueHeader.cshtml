@model PublicWeb.Models.Public.LeagueViewModel?
@{
    var league = Model ?? ViewBag.League as PublicWeb.Models.Public.LeagueViewModel;
    var seasonName = ViewBag.SeasonName as string;
    var leagueSlug = ViewBag.LeagueSlug as string ?? league?.Slug ?? "";
    var hasLogo = !string.IsNullOrWhiteSpace(league?.LogoUrl);
    var initials = PublicWeb.Helpers.TeamDisplayHelper.GetInitials(league?.Name);
    var h1 = ViewBag.SeoH1 as string ?? league?.Name ?? "Liga";
    var logoAlt = league != null ? $"Logo {league.Name}" : "Logo de la liga";
    var stats = ViewBag.LeagueHeroStats as PublicWeb.Models.Public.LeagueHeroStatsViewModel;
    var location = league?.Country;
    var showLocation = !string.IsNullOrWhiteSpace(location);

    string DivisionLabel(int n) => n == 1 ? "división" : "divisiones";
    string TeamLabel(int n) => n == 1 ? "equipo" : "equipos";
}
<header class="v2-league-hero">
    <div class="v2-league-hero__inner">
        <div class="v2-league-hero__identity">
            @if (league != null)
            {
                <div class="v2-league-hero__logo @(hasLogo ? "has-logo" : "is-fallback")"
                     data-v2-team-badge>
                    @if (hasLogo)
                    {
                        <img src="@league.LogoUrl"
                             alt="@logoAlt"
                             width="120"
                             height="120"
                             loading="eager"
                             fetchpriority="high"
                             decoding="async"
                             data-v2-team-logo />
                        <span class="v2-league-hero__initials" data-v2-team-initials>@initials</span>
                    }
                    else
                    {
                        <span class="v2-league-hero__initials" aria-hidden="true">@initials</span>
                    }
                </div>
            }
            <div class="v2-league-hero__copy">
                <h1 class="v2-league-hero__name">@h1</h1>
                @if (!string.IsNullOrWhiteSpace(seasonName))
                {
                    <p class="v2-league-hero__season">
                        <span class="v2-ui-icon v2-ui-icon--trophy" aria-hidden="true"></span>
                        <span>@seasonName</span>
                    </p>
                }
                @if (showLocation)
                {
                    <p class="v2-league-hero__location">
                        <span class="v2-ui-icon v2-ui-icon--location v2-ui-icon--sm" aria-hidden="true"></span>
                        <span>@location</span>
                    </p>
                }
            </div>
        </div>

        @if (stats != null && (stats.DivisionCount.HasValue || stats.TeamCount.HasValue || stats.CurrentRound.HasValue))
        {
            <ul class="v2-league-hero__stats">
                @if (stats.DivisionCount.HasValue)
                {
                    <li>
                        <span class="v2-ui-icon v2-ui-icon--teams" aria-hidden="true"></span>
                        <span>@stats.DivisionCount.Value @DivisionLabel(stats.DivisionCount.Value)</span>
                    </li>
                }
                @if (stats.TeamCount.HasValue)
                {
                    <li>
                        <span class="v2-ui-icon v2-ui-icon--division" aria-hidden="true"></span>
                        <span>@stats.TeamCount.Value @TeamLabel(stats.TeamCount.Value)</span>
                    </li>
                }
                @if (stats.CurrentRound.HasValue)
                {
                    <li>
                        <span class="v2-ui-icon v2-ui-icon--calendar" aria-hidden="true"></span>
                        <span>
                            Fecha @stats.CurrentRound.Value
                            @if (string.Equals(stats.CurrentRoundStatus, "En curso", StringComparison.OrdinalIgnoreCase))
                            {
                                <span>en curso</span>
                            }
                        </span>
                    </li>
                }
            </ul>
        }

        @if (!string.IsNullOrWhiteSpace(leagueSlug))
        {
            <div class="v2-league-hero__actions">
                @{
                    ViewData["FollowScopeType"] = "League";
                    ViewData["FollowScopeId"] = league?.Id ?? Guid.Empty;
                    ViewData["FollowLabel"] = "Seguir liga";
                    ViewData["FollowFollowingLabel"] = "Siguiendo";
                }
                @await Html.PartialAsync("~/Views/Shared/V2/_FollowButton.cshtml")
                @{
                    ViewData["ShareTitle"] = league?.Name ?? h1;
                    ViewData["ShareText"] = league != null
                        ? $"Seguí {league.Name} en MiLiga"
                        : "Seguí esta liga en MiLiga";
                    ViewData["SharePath"] = $"/ligas/{leagueSlug}";
                }
                @await Html.PartialAsync("~/Views/Shared/V2/_ShareButton.cshtml")
            </div>
        }
    </div>
</header>
