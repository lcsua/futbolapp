@model PublicWeb.Models.Public.LeagueViewModel?
@{
    ViewBag.LeagueDetails = true;
    var league = Model ?? ViewBag.League as PublicWeb.Models.Public.LeagueViewModel;
    var seasonName = ViewBag.SeasonName as string;
    var leagueSlug = ViewBag.LeagueSlug as string ?? league?.Slug ?? "";
    var hasLogo = !string.IsNullOrWhiteSpace(league?.LogoUrl);
    var initials = PublicWeb.Helpers.TeamDisplayHelper.GetInitials(league?.Name);
    var h1 = ViewBag.SeoH1 as string ?? league?.Name ?? "Liga";
    var logoAlt = league != null ? $"Logo {league.Name}" : "Logo de la liga";
    var stats = ViewBag.LeagueHeroStats as PublicWeb.Models.Public.LeagueHeroStatsViewModel;
    var nameLead = (string?)null;
    var nameMain = h1;
    if (nameMain.StartsWith("Liga de ", StringComparison.OrdinalIgnoreCase))
    {
        nameLead = "Liga de";
        nameMain = nameMain["Liga de ".Length..].Trim();
    }

    string DivisionLabel(int n) => n == 1 ? "división" : "divisiones";
    string TeamLabel(int n) => n == 1 ? "equipo" : "equipos";
}
<header class="v2-league-hero">
    <div class="v2-league-hero__ad">
        @await Component.InvokeAsync("LeagueAds", new { slot = "PageTop", variant = "in-hero" })
    </div>
    <div class="v2-league-hero__inner">
        @if (league != null)
        {
            <div class="v2-league-hero__logo @(hasLogo ? "has-logo" : "is-fallback")">
                @if (hasLogo)
                {
                    <img src="@league.LogoUrl"
                         alt="@logoAlt"
                         width="96"
                         height="96"
                         loading="eager"
                         fetchpriority="high"
                         decoding="async"
                         onerror="this.parentElement.classList.remove('has-logo'); this.parentElement.classList.add('is-fallback'); this.remove();" />
                }
                <span class="v2-league-hero__initials" aria-hidden="true">@initials</span>
            </div>
        }

        <div class="v2-league-hero__copy">
            <h1 class="v2-league-hero__name">
                @if (!string.IsNullOrWhiteSpace(nameLead))
                {
                    <span class="v2-league-hero__lead">@nameLead</span>
                }
                <span class="v2-league-hero__title">@nameMain</span>
            </h1>
            @if (!string.IsNullOrWhiteSpace(seasonName))
            {
                <p class="v2-league-hero__season">
                    <span class="v2-ui-icon v2-ui-icon--trophy" aria-hidden="true"></span>
                    <span>@seasonName</span>
                </p>
            }
            @if (league != null && (!string.IsNullOrWhiteSpace(league.FacebookUrl) ||
                !string.IsNullOrWhiteSpace(league.InstagramUrl) ||
                !string.IsNullOrWhiteSpace(league.YouTubeUrl) ||
                !string.IsNullOrWhiteSpace(league.TikTokUrl)))
            {
                <nav class="v2-league-hero__socials" aria-label="Redes sociales de la liga">
                    @if (!string.IsNullOrWhiteSpace(league.FacebookUrl))
                    {
                        <a href="@league.FacebookUrl" target="_blank" rel="noopener noreferrer" aria-label="Facebook de @league.Name">Facebook</a>
                    }
                    @if (!string.IsNullOrWhiteSpace(league.InstagramUrl))
                    {
                        <a href="@league.InstagramUrl" target="_blank" rel="noopener noreferrer" aria-label="Instagram de @league.Name">Instagram</a>
                    }
                    @if (!string.IsNullOrWhiteSpace(league.YouTubeUrl))
                    {
                        <a href="@league.YouTubeUrl" target="_blank" rel="noopener noreferrer" aria-label="YouTube de @league.Name">YouTube</a>
                    }
                    @if (!string.IsNullOrWhiteSpace(league.TikTokUrl))
                    {
                        <a href="@league.TikTokUrl" target="_blank" rel="noopener noreferrer" aria-label="TikTok de @league.Name">TikTok</a>
                    }
                </nav>
            }

            @if (stats != null && (stats.DivisionCount.HasValue || stats.TeamCount.HasValue || stats.CurrentRound.HasValue))
            {
                <ul class="v2-league-hero__stats">
                    @if (stats.DivisionCount.HasValue)
                    {
                        <li>
                            <span class="v2-ui-icon v2-ui-icon--teams" aria-hidden="true"></span>
                            <span class="v2-league-hero__stat-num v2-nums">@stats.DivisionCount.Value</span>
                            <span class="v2-league-hero__stat-lbl">@DivisionLabel(stats.DivisionCount.Value)</span>
                        </li>
                    }
                    @if (stats.TeamCount.HasValue)
                    {
                        <li>
                            <span class="v2-ui-icon v2-ui-icon--division" aria-hidden="true"></span>
                            <span class="v2-league-hero__stat-num v2-nums">@stats.TeamCount.Value</span>
                            <span class="v2-league-hero__stat-lbl">@TeamLabel(stats.TeamCount.Value)</span>
                        </li>
                    }
                    @if (stats.CurrentRound.HasValue)
                    {
                        <li>
                            <span class="v2-ui-icon v2-ui-icon--calendar" aria-hidden="true"></span>
                            <span class="v2-league-hero__stat-num v2-nums">@stats.CurrentRound.Value</span>
                            <span class="v2-league-hero__stat-lbl">
                                @(string.Equals(stats.CurrentRoundStatus, "En curso", StringComparison.OrdinalIgnoreCase)
                                    ? "Fecha en curso"
                                    : "Fecha")
                            </span>
                        </li>
                    }
                </ul>
            }
        </div>

        @if (!string.IsNullOrWhiteSpace(leagueSlug))
        {
            <div class="v2-league-hero__actions">
                @{
                    ViewData["FollowScopeType"] = "League";
                    ViewData["FollowScopeId"] = league?.Id ?? Guid.Empty;
                    ViewData["FollowLabel"] = "Seguir liga";
                    ViewData["FollowFollowingLabel"] = "Siguiendo";
                }
                @await Html.PartialAsync("~/Views/Shared/V2/_FollowButton.cshtml")
                @{
                    ViewData["ShareTitle"] = league?.Name ?? h1;
                    ViewData["ShareText"] = league != null
                        ? $"Seguí {league.Name} en MiLiga"
                        : "Seguí esta liga en MiLiga";
                    ViewData["SharePath"] = $"/ligas/{leagueSlug}";
                }
                @await Html.PartialAsync("~/Views/Shared/V2/_ShareButton.cshtml")
                <div class="v2-home-pin" data-home-league-pin="@leagueSlug">
                    <button type="button"
                            class="v2-home-pin-btn"
                            data-home-league-pin-trigger
                            aria-pressed="false"
                            aria-label="Usar esta liga al abrir Mi Liga">
                        <span class="v2-ui-icon v2-ui-icon--home v2-home-pin-btn__icon" aria-hidden="true"></span>
                        <span class="v2-home-pin-btn__label" data-home-league-pin-label>Fijar inicio</span>
                    </button>
                </div>
            </div>
        }
    </div>
</header>
