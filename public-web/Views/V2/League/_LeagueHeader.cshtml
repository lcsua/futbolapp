@model PublicWeb.Models.Public.LeagueViewModel?
@{
    var league = Model ?? ViewBag.League as PublicWeb.Models.Public.LeagueViewModel;
    var seasonName = ViewBag.SeasonName as string;
    var leagueSlug = ViewBag.LeagueSlug as string ?? league?.Slug ?? "";
    var season = ViewBag.SeasonSlug as string;
    var qs = string.IsNullOrWhiteSpace(season) ? "" : $"?season={Uri.EscapeDataString(season)}";
    var activeTab = ViewBag.V2LeagueTab as string ?? "";
    var isInfoPage = string.Equals(activeTab, "informacion", StringComparison.OrdinalIgnoreCase);
    var showLocation = !string.IsNullOrWhiteSpace(league?.Country);
    var hasLogo = !string.IsNullOrWhiteSpace(league?.LogoUrl);
    var initials = PublicWeb.Helpers.TeamDisplayHelper.GetInitials(league?.Name);
    var h1 = ViewBag.SeoH1 as string ?? league?.Name ?? "Liga";
    var logoAlt = league != null ? $"Logo {league.Name}" : "Logo de la liga";

    var metaParts = new List<string>();
    if (!string.IsNullOrWhiteSpace(seasonName)) metaParts.Add(seasonName);
    if (showLocation) metaParts.Add(league!.Country);
    var metaLine = string.Join(" · ", metaParts);
}
<header class="v2-league-header">
    <div class="v2-league-header__identity">
        @if (league != null)
        {
            <div class="v2-league-header__logo @(hasLogo ? "has-logo" : "is-fallback")"
                 data-v2-team-badge>
                @if (hasLogo)
                {
                    <img src="@league.LogoUrl"
                         alt="@logoAlt"
                         width="120"
                         height="120"
                         loading="eager"
                         decoding="async"
                         data-v2-team-logo />
                    <span class="v2-league-header__initials" data-v2-team-initials>@initials</span>
                }
                else
                {
                    <span class="v2-league-header__initials" aria-hidden="true">@initials</span>
                }
            </div>
        }
        <div class="v2-league-header__copy">
            <h1 class="v2-league-header__name">@h1</h1>
            @if (!string.IsNullOrWhiteSpace(metaLine))
            {
                <p class="v2-league-header__meta">@metaLine</p>
            }
            @if (!string.IsNullOrWhiteSpace(leagueSlug))
            {
                <a class="v2-league-info-btn @(isInfoPage ? "is-active" : null)"
                   href="@Url.Content($"~/ligas/{leagueSlug}/informacion")@qs"
                   aria-current="@(isInfoPage ? "page" : null)">
                    <svg class="v2-league-info-btn__icon" width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true" focusable="false">
                        <circle cx="12" cy="12" r="9" stroke="currentColor" stroke-width="1.75" />
                        <path d="M12 11v5.5" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" />
                        <circle cx="12" cy="8" r="1.1" fill="currentColor" />
                    </svg>
                    <span>Información de la liga</span>
                </a>
            }
        </div>
    </div>
</header>
