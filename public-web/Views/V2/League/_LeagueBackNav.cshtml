@{
    var crumbs = ViewBag.SeoBreadcrumbs as IReadOnlyList<PublicWeb.Seo.SeoBreadcrumbItem>;
}
<nav class="v2-crumb" aria-label="Migajas">
    @if (crumbs != null && crumbs.Count > 0)
    {
        <ol class="visually-hidden">
            @for (var i = 0; i < crumbs.Count; i++)
            {
                var c = crumbs[i];
                <li>
                    @if (!string.IsNullOrWhiteSpace(c.Path) && i < crumbs.Count - 1)
                    {
                        <a href="@Url.Content("~" + c.Path)">@c.Name</a>
                    }
                    else
                    {
                        <span aria-current="page">@c.Name</span>
                    }
                </li>
            }
        </ol>
    }
    <a class="v2-crumb__back" href="@Url.Content("~/ligas")">
        <span aria-hidden="true">‹</span> Todas las ligas
    </a>
</nav>
