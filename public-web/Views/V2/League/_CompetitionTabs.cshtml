@{
    var leagueSlug = ViewBag.LeagueSlug as string
        ?? (ViewBag.League as PublicWeb.Models.Public.LeagueViewModel)?.Slug
        ?? "";
    var active = ViewBag.V2LeagueTab as string ?? "";
    var season = ViewBag.SeasonSlug as string;
    var qs = string.IsNullOrWhiteSpace(season) ? "" : $"?season={Uri.EscapeDataString(season)}";
}
@if (!string.IsNullOrWhiteSpace(leagueSlug))
{
    <nav class="v2-tabs v2-league-tabs" aria-label="Secciones de la liga">
        <a class="v2-tabs__link @(active == "resumen" ? "is-active" : null)"
           href="@Url.Content($"~/ligas/{leagueSlug}")@qs"
           aria-current="@(active == "resumen" ? "page" : null)">Resumen</a>
        <a class="v2-tabs__link @(active == "fixture" ? "is-active" : null)"
           href="@Url.Content($"~/ligas/{leagueSlug}/fixture")@qs"
           aria-current="@(active == "fixture" ? "page" : null)">Fixture</a>
        <a class="v2-tabs__link @(active == "posiciones" ? "is-active" : null)"
           href="@Url.Content($"~/ligas/{leagueSlug}/posiciones")@qs"
           aria-current="@(active == "posiciones" ? "page" : null)">Posiciones</a>
        <a class="v2-tabs__link @(active == "resultados" ? "is-active" : null)"
           href="@Url.Content($"~/ligas/{leagueSlug}/resultados")@qs"
           aria-current="@(active == "resultados" ? "page" : null)">Resultados</a>
    </nav>
}
