@{
    ViewBag.LeagueDetails = true;
    var leagueSlug = ViewBag.LeagueSlug as string
        ?? (ViewBag.League as PublicWeb.Models.Public.LeagueViewModel)?.Slug
        ?? "";
    var active = ViewBag.V2LeagueTab as string ?? "";
    var season = ViewBag.SeasonSlug as string;
    var division = ViewBag.Division as string;
    if (string.IsNullOrWhiteSpace(division))
        division = Context.Request.Query["division"].ToString();

    string Tab(string section) => Url.Content(PublicWeb.Helpers.LeagueLinks.Section(leagueSlug, section, season, division))!;
}
@if (!string.IsNullOrWhiteSpace(leagueSlug))
{
    <nav class="v2-tabs v2-league-tabs" aria-label="Secciones de la liga">
        <a class="v2-tabs__link @(active == "resumen" ? "is-active" : null)"
           href="@Tab("")"
           aria-current="@(active == "resumen" ? "page" : null)">
            <span class="v2-ui-icon v2-ui-icon--home" aria-hidden="true"></span>
            <span>Resumen</span>
        </a>
        <a class="v2-tabs__link @(active == "fixture" ? "is-active" : null)"
           href="@Tab("fixture")"
           aria-current="@(active == "fixture" ? "page" : null)">
            <span class="v2-ui-icon v2-ui-icon--calendar" aria-hidden="true"></span>
            <span>Fixture</span>
        </a>
        <a class="v2-tabs__link @(active == "posiciones" ? "is-active" : null)"
           href="@Tab("posiciones")"
           aria-current="@(active == "posiciones" ? "page" : null)">
            <span class="v2-ui-icon v2-ui-icon--trophy" aria-hidden="true"></span>
            <span>Posiciones</span>
        </a>
        <a class="v2-tabs__link @(active == "predicciones" ? "is-active" : null)"
           href="@Tab("predicciones")"
           aria-current="@(active == "predicciones" ? "page" : null)">
            <span class="v2-ui-icon v2-ui-icon--simulate" aria-hidden="true"></span>
            <span>Predicciones</span>
        </a>
        <a class="v2-tabs__link @(active == "resultados" ? "is-active" : null)"
           href="@Tab("resultados")"
           aria-current="@(active == "resultados" ? "page" : null)">
            <span class="v2-ui-icon v2-ui-icon--results" aria-hidden="true"></span>
            <span>Resultados</span>
        </a>
        <a class="v2-tabs__link @(active == "informacion" ? "is-active" : null)"
           href="@Tab("informacion")"
           aria-current="@(active == "informacion" ? "page" : null)">
            <span class="v2-ui-icon v2-ui-icon--info" aria-hidden="true"></span>
            <span>Información</span>
        </a>
    </nav>
}
