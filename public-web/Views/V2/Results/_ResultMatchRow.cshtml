@model PublicWeb.Models.Public.MatchViewModel
@{
    var leagueSlug = ViewData["LeagueSlug"] as string ?? Model.LeagueSlug ?? "";
    var suspended = PublicWeb.Helpers.TeamDisplayHelper.IsSuspended(Model.Status);
    var hasScores = Model.HomeScore.HasValue && Model.AwayScore.HasValue;
    ViewData["BadgeSize"] = "md";

    string? TeamUrl(PublicWeb.Models.Public.TeamViewModel team) =>
        !string.IsNullOrWhiteSpace(leagueSlug) && !string.IsNullOrWhiteSpace(team.Slug)
            ? Url.Content($"~/v2/ligas/{leagueSlug}/{team.Slug}")
            : null;
    var homeUrl = TeamUrl(Model.HomeTeam);
    var awayUrl = TeamUrl(Model.AwayTeam);
}
<article class="v2-result-row">
    <div class="v2-result-row__inner">
        <div class="v2-result-row__board">
            @if (homeUrl != null)
            {
                <a class="v2-result-row__side is-home" href="@homeUrl">
                    @await Html.PartialAsync("~/Views/V2/Team/_TeamBadge.cshtml", Model.HomeTeam)
                    <span class="v2-result-row__name">@Model.HomeTeam.Name</span>
                </a>
            }
            else
            {
                <div class="v2-result-row__side is-home">
                    @await Html.PartialAsync("~/Views/V2/Team/_TeamBadge.cshtml", Model.HomeTeam)
                    <span class="v2-result-row__name">@Model.HomeTeam.Name</span>
                </div>
            }

            <div class="v2-result-row__mid">
                <a class="v2-result-row__scorewrap" href="@Url.Content($"~/partido/{Model.Id}")">
                    @if (suspended)
                    {
                        <span class="v2-result-row__status is-warn">Suspendido</span>
                    }
                    else if (hasScores)
                    {
                        <span class="v2-result-row__score v2-nums">@Model.HomeScore — @Model.AwayScore</span>
                    }
                    else
                    {
                        <span class="v2-result-row__status">Sin resultado</span>
                    }
                </a>
            </div>

            @if (awayUrl != null)
            {
                <a class="v2-result-row__side is-away" href="@awayUrl">
                    @await Html.PartialAsync("~/Views/V2/Team/_TeamBadge.cshtml", Model.AwayTeam)
                    <span class="v2-result-row__name">@Model.AwayTeam.Name</span>
                </a>
            }
            else
            {
                <div class="v2-result-row__side is-away">
                    @await Html.PartialAsync("~/Views/V2/Team/_TeamBadge.cshtml", Model.AwayTeam)
                    <span class="v2-result-row__name">@Model.AwayTeam.Name</span>
                </div>
            }
        </div>
    </div>
</article>
