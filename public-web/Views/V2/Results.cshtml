@model PublicWeb.Models.Public.SeasonGroupedViewModel<PublicWeb.Models.Public.MatchdayGroupViewModel>
@{
    Layout = "~/Views/Shared/V2/_V2Layout.cshtml";
    var league = ViewBag.League as PublicWeb.Models.Public.LeagueViewModel;
    var seasons = ViewBag.Seasons as List<PublicWeb.Models.Public.SeasonViewModel>;
    var leagueSlug = league?.Slug ?? string.Empty;
    var selectedSeason = seasons?.FirstOrDefault(s => Model != null && Model.SeasonSlug == s.Slug)
        ?? seasons?.FirstOrDefault();
    var divisions = selectedSeason?.Divisions ?? new List<PublicWeb.Models.Public.DivisionViewModel>();
    var selectedDivision = ViewBag.Division as string ?? "all";
    var requestingRound = ViewBag.Round as int?;

    ViewData["Title"] = "Resultados" + (league != null ? $" · {league.Name}" : string.Empty);
    ViewData["Description"] = $"Resultados de {league?.Name}.";
    ViewBag.PageLabel = "Resultados";
    ViewBag.SeasonName = Model?.SeasonName ?? selectedSeason?.Name;
    ViewBag.SeasonSlug = Model?.SeasonSlug ?? selectedSeason?.Slug;
    ViewBag.LeagueSlug = leagueSlug;
}

<nav class="v2-crumb" aria-label="Migajas">
    <div class="v2-crumb__desktop">
        <a href="@Url.Content("~/v2/ligas")">Ligas</a>
        @if (league != null)
        {
            <span aria-hidden="true">/</span>
            <a href="@Url.Content($"~/ligas/{leagueSlug}")">@league.Name</a>
        }
        <span aria-hidden="true">/</span>
        <span aria-current="page">Resultados</span>
    </div>
    @if (league != null)
    {
        <a class="v2-crumb__mobile" href="@Url.Content($"~/ligas/{leagueSlug}")">
            <span aria-hidden="true">‹</span> @league.Name
        </a>
    }
    else
    {
        <a class="v2-crumb__mobile" href="@Url.Content("~/v2/ligas")">
            <span aria-hidden="true">‹</span> Ligas
        </a>
    }
</nav>

@await Html.PartialAsync("~/Views/V2/League/_LeagueHeader.cshtml", league)

@await Html.PartialAsync("~/Views/V2/League/_CompetitionTabs.cshtml")

@if (seasons != null && seasons.Any())
{
    <form method="get" class="v2-filter-bar" aria-label="Filtros de resultados">
        <div class="v2-filter-bar__group">
            <label for="v2-filter-season">Temporada</label>
            <select id="v2-filter-season" name="season" class="v2-select" onchange="this.form.submit()">
                @foreach (var s in seasons)
                {
                    if (Model != null && Model.SeasonSlug == s.Slug)
                    {
                        <option value="@s.Slug" selected>@s.Name</option>
                    }
                    else
                    {
                        <option value="@s.Slug">@s.Name</option>
                    }
                }
            </select>
        </div>
        <div class="v2-filter-bar__group">
            <label for="v2-filter-division">División</label>
            <select id="v2-filter-division" name="division" class="v2-select" onchange="this.form.submit()">
                @if (selectedDivision == "all")
                {
                    <option value="all" selected>Todas</option>
                }
                else
                {
                    <option value="all">Todas</option>
                }
                @foreach (var d in divisions)
                {
                    if (selectedDivision == d.Slug)
                    {
                        <option value="@d.Slug" selected>@d.Name</option>
                    }
                    else
                    {
                        <option value="@d.Slug">@d.Name</option>
                    }
                }
            </select>
        </div>
    </form>
}

@if (Model != null && Model.Divisions.Any())
{
    foreach (var div in Model.Divisions)
    {
        <section class="v2-result-group" aria-labelledby="div-@div.DivisionSlug">
            @if (Model.Divisions.Count > 1 || selectedDivision == "all")
            {
                <h2 id="div-@div.DivisionSlug" class="v2-section-title">@div.DivisionName</h2>
            }

            @if (div.Data != null && div.Data.Any())
            {
                var activeMatchday = requestingRound.HasValue
                    ? div.Data.FirstOrDefault(m => m.Round == requestingRound)
                    : div.Data.FirstOrDefault();
                if (activeMatchday == null) activeMatchday = div.Data.FirstOrDefault();
                var currentRoundNav = activeMatchday?.Round;

                <div class="v2-round-pills" role="list" aria-label="Fechas">
                    @foreach (var matchday in div.Data)
                    {
                        var href = $"?season={Uri.EscapeDataString(Model.SeasonSlug)}&division={Uri.EscapeDataString(selectedDivision)}&round={matchday.Round}";
                        <a class="v2-round-pills__item @(matchday.Round == currentRoundNav ? "is-active" : null)"
                           role="listitem"
                           href="@href"
                           aria-current="@(matchday.Round == currentRoundNav ? "page" : null)">Fecha @matchday.Round</a>
                    }
                </div>

                @if (activeMatchday != null && activeMatchday.Matches.Any())
                {
                    var groupDate = activeMatchday.Matches
                        .Select(m => m.Kickoff.Date)
                        .Where(d => d != default)
                        .GroupBy(d => d)
                        .OrderByDescending(g => g.Count())
                        .Select(g => g.Key)
                        .FirstOrDefault();

                    <div class="v2-result-group__meta">
                        <span class="v2-result-group__round">Fecha @activeMatchday.Round</span>
                        @if (groupDate != default)
                        {
                            <span class="v2-result-group__sep" aria-hidden="true">·</span>
                            <span class="v2-result-group__date">@PublicWeb.Helpers.TeamDisplayHelper.FormatWeekdayDayMonth(groupDate)</span>
                        }
                    </div>

                    <div class="v2-result-list">
                        @{
                            ViewData["LeagueSlug"] = leagueSlug;
                        }
                        @foreach (var match in activeMatchday.Matches)
                        {
                            @await Html.PartialAsync("~/Views/V2/Results/_ResultMatchRow.cshtml", match)
                        }
                    </div>
                }
                else
                {
                    <div class="v2-empty">No hay resultados en esta fecha.</div>
                }
            }
            else
            {
                <div class="v2-empty">No hay resultados registrados en esta división.</div>
            }
        </section>
    }
}
else
{
    <div class="v2-empty">No hay resultados para esta selección.</div>
}
