@{
    Layout = "~/Views/Shared/V2/_V2Layout.cshtml";
}

<section class="v2-contact">
    <h1 class="v2-page-title">Gracias</h1>
    <p class="v2-page-lead" style="margin-bottom: var(--space-6, 1.5rem); max-width: 34rem;">
        Recibimos tu consulta. Nos pondremos en contacto para ayudarte a publicar tu liga.
    </p>
    <p style="display:flex;flex-wrap:wrap;gap:0.75rem;align-items:center">
        <a class="v2-button" href="@Url.Content("~/")">Ir al inicio</a>
