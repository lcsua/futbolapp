@model PublicWeb.Models.Public.MatchViewModel
@{
    ViewData["BadgeSize"] = "featured";
    ViewData["BadgePlain"] = true;
    ViewData["PreferFullLogo"] = true;
    ViewData["BadgeEager"] = true;
    var venue = PublicWeb.Helpers.TeamDisplayHelper.FormatFieldLabel(Model.FieldName);
    var time = PublicWeb.Helpers.TeamDisplayHelper.FormatTimeOrNull(Model.Kickoff);
    var sharePath = ViewData["UpcomingSharePath"] as string;
    var shareLeague = ViewData["UpcomingShareLeague"] as string;
    var shareText = PublicWeb.Helpers.TeamDisplayHelper.FormatUpcomingShareText(Model, shareLeague);
    var preview = ViewData["CardPreview"] as PublicWeb.Models.Public.MatchCardPreview;
    var showPlace = preview?.ShowPlace == true;
    var showForm = preview?.ShowForm == true;

    PublicWeb.Models.Public.MatchSideViewModel Side(bool home) => new()
    {
        Team = home ? Model.HomeTeam : Model.AwayTeam,
        Arrival = home ? preview?.Home : preview?.Away,
        ShowPlace = showPlace,
        ShowForm = showForm,
        FullPlace = false
    };
}
<article class="v2-match-card v2-match-card--upcoming v2-match-card--featured">
    <a class="v2-match-card__link" href="@Url.Content(MatchSlugHelper.AppRelative(Model))">
        <div class="v2-match-card__meta v2-match-card__meta--upcoming">
            <span class="v2-match-card__meta-desktop">Próximo partido</span>
            <span class="v2-match-card__meta-mobile">
                @PublicWeb.Helpers.TeamDisplayHelper.FormatWeekdayDayMonth(Model.Kickoff)
            </span>
            @if (time != null)
            {
                <span class="v2-match-card__kick v2-nums">@time</span>
            }
            @if (!string.IsNullOrWhiteSpace(venue))
            {
                <span class="v2-match-card__venue">@await Html.PartialAsync("~/Views/Shared/V2/_FieldLabel.cshtml", venue)</span>
            }
        </div>

        <div class="v2-match-card__meta-line v2-match-card__meta-line--desktop">
            <span class="v2-nums">@PublicWeb.Helpers.TeamDisplayHelper.FormatDayMonth(Model.Kickoff)</span>
            @if (time != null)
            {
                <span aria-hidden="true">·</span>
                <span class="v2-nums">@time</span>
            }
            @if (!string.IsNullOrWhiteSpace(venue))
            {
                <span aria-hidden="true">·</span>
                @await Html.PartialAsync("~/Views/Shared/V2/_FieldLabel.cshtml", venue)
            }
        </div>

        <div class="v2-match-card__board">
            <div class="v2-match-card__side is-home">
                @await Html.PartialAsync("~/Views/V2/Team/_MatchSide.cshtml", Side(true))
            </div>
            <div class="v2-match-card__center">
                <span class="v2-match-card__vs">VS</span>
            </div>
            <div class="v2-match-card__side is-away">
                @await Html.PartialAsync("~/Views/V2/Team/_MatchSide.cshtml", Side(false))
            </div>
        </div>
        <span class="v2-match-card__preview">Ver previa <span aria-hidden="true">›</span></span>
    </a>
    @if (!string.IsNullOrWhiteSpace(sharePath))
    {
        <div class="v2-match-card__share">
            @{
                ViewData["ShareTitle"] = PublicWeb.Helpers.TeamDisplayHelper.FormatUpcomingOgTitle(Model);
                ViewData["ShareText"] = shareText;
                ViewData["SharePath"] = sharePath;
                ViewData["ShareCompact"] = true;
            }
            @await Html.PartialAsync("~/Views/Shared/V2/_ShareButton.cshtml")
        </div>
    }
</article>
@{
    ViewData["BadgeSize"] = "md";
    ViewData["BadgePlain"] = false;
    ViewData["PreferFullLogo"] = false;
    ViewData["BadgeEager"] = false;
}
