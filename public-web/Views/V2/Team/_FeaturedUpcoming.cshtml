@model PublicWeb.Models.Public.MatchViewModel
@{
    ViewData["BadgeSize"] = "md";
}
<a class="v2-feature v2-feature--upcoming" href="@Url.Content($"~/partido/{Model.Id}")">
    <div class="v2-feature__eyebrow">Próximo partido</div>
    <div class="v2-feature__board v2-feature__board--upcoming">
        <div class="v2-feature__club is-home">
            <span class="v2-feature__club-name">@Model.HomeTeam.Name</span>
            @await Html.PartialAsync("~/Views/V2/Team/_TeamBadge.cshtml", Model.HomeTeam)
        </div>
        <div class="v2-feature__scorewrap">
            <div class="v2-feature__kick">@PublicWeb.Helpers.TeamDisplayHelper.FormatTime(Model.Kickoff)</div>
        </div>
        <div class="v2-feature__club is-away">
            @await Html.PartialAsync("~/Views/V2/Team/_TeamBadge.cshtml", Model.AwayTeam)
            <span class="v2-feature__club-name">@Model.AwayTeam.Name</span>
        </div>
    </div>
    <div class="v2-feature__date">@PublicWeb.Helpers.TeamDisplayHelper.FormatLongDate(Model.Kickoff)</div>
    @if (!string.IsNullOrWhiteSpace(Model.FieldName))
    {
        <div class="v2-feature__venue">@Model.FieldName</div>
    }
</a>
