@model PublicWeb.Models.Public.MatchViewModel
@{
    var finished = PublicWeb.Helpers.TeamDisplayHelper.IsFinished(Model.Status);
    var suspended = PublicWeb.Helpers.TeamDisplayHelper.IsSuspended(Model.Status);
    var venue = PublicWeb.Helpers.TeamDisplayHelper.FormatFieldLabel(Model.FieldName);
    var time = PublicWeb.Helpers.TeamDisplayHelper.FormatTimeOrNull(Model.Kickoff);
    ViewData["BadgeSize"] = "md";
}
<a class="v2-match-row @(finished ? "is-result" : "is-upcoming")" href="@Url.Content($"~/partido/{Model.Id}")">
    @* Desktop: centered unit — meta then LOCAL | MID | VISITANTE *@
    <div class="v2-match-row__desktop">
        <div class="v2-upcoming-match-inner">
            <div class="v2-match-meta">
                @if (finished)
                {
                    <span class="v2-match-meta__date v2-nums">@PublicWeb.Helpers.TeamDisplayHelper.FormatDayMonth(Model.Kickoff)</span>
                }
                else
                {
                    <span class="v2-match-meta__date">@PublicWeb.Helpers.TeamDisplayHelper.FormatWeekdayDayMonth(Model.Kickoff)</span>
                    @if (time != null)
                    {
                        <span class="v2-match-meta__time v2-nums">@time</span>
                    }
                    @if (!string.IsNullOrWhiteSpace(venue))
                    {
                        <span class="v2-match-meta__venue">@venue</span>
                    }
                }
            </div>

            <div class="v2-match-row__board">
                <div class="v2-match-row__home">
                    <span class="v2-match-row__name">@Model.HomeTeam.Name</span>
                    @await Html.PartialAsync("~/Views/V2/Team/_TeamBadge.cshtml", Model.HomeTeam)
                </div>
                <span class="v2-match-row__mid v2-nums">
                    @if (finished)
                    {
                        if (suspended)
                        {
                            <span class="is-warn">Susp.</span>
                        }
                        else
                        {
                            <span class="v2-match-row__score">@Model.HomeScore — @Model.AwayScore</span>
                        }
                    }
                    else
                    {
                        <span class="v2-match-row__vs">VS</span>
                    }
                </span>
                <div class="v2-match-row__away">
                    @await Html.PartialAsync("~/Views/V2/Team/_TeamBadge.cshtml", Model.AwayTeam)
                    <span class="v2-match-row__name">@Model.AwayTeam.Name</span>
                </div>
            </div>
        </div>
    </div>

    @* Mobile — unchanged classic LOCAL | CENTER | VISITANTE MatchCard *@
    <div class="v2-match-row__mobile">
        <div class="v2-match-card v2-match-card--inline @(finished ? "v2-match-card--result" : "v2-match-card--upcoming")">
            <div class="v2-match-card__meta">
                @if (finished)
                {
                    <span>
                        @(suspended ? "Suspendido" : "Finalizado")
                        <span aria-hidden="true">·</span>
                        @PublicWeb.Helpers.TeamDisplayHelper.FormatDayMonth(Model.Kickoff)
                    </span>
                }
                else
                {
                    <span>@PublicWeb.Helpers.TeamDisplayHelper.FormatWeekdayDayMonth(Model.Kickoff)</span>
                    @if (time != null)
                    {
                        <span class="v2-match-card__kick v2-nums">@time</span>
                    }
                    @if (!string.IsNullOrWhiteSpace(venue))
                    {
                        <span class="v2-match-card__venue">@venue</span>
                    }
                }
            </div>

            <div class="v2-match-card__board">
                <div class="v2-match-card__side is-home">
                    @await Html.PartialAsync("~/Views/V2/Team/_TeamBadge.cshtml", Model.HomeTeam)
                    <span class="v2-match-card__name">@Model.HomeTeam.Name</span>
                </div>
                <div class="v2-match-card__center">
                    @if (finished)
                    {
                        if (suspended)
                        {
                            <span class="v2-match-card__score is-warn">—</span>
                        }
                        else
                        {
                            <span class="v2-match-card__score">@Model.HomeScore — @Model.AwayScore</span>
                        }
                    }
                    else
                    {
                        <span class="v2-match-card__vs">VS</span>
                    }
                </div>
                <div class="v2-match-card__side is-away">
                    @await Html.PartialAsync("~/Views/V2/Team/_TeamBadge.cshtml", Model.AwayTeam)
                    <span class="v2-match-card__name">@Model.AwayTeam.Name</span>
                </div>
            </div>
        </div>
    </div>
</a>
