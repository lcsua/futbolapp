@model PublicWeb.Models.Public.TeamDetailViewModel
@{
    const int slots = 5;
    var letters = Model.LastResults
        .Select(m => PublicWeb.Helpers.TeamDisplayHelper.FormLetter(m, Model.Team.Id))
        .Where(c => c.HasValue)
        .Select(c => c!.Value)
        .Take(slots)
        .ToList();
    var form = new PublicWeb.Models.Public.FormSlotsViewModel
    {
        Letters = letters,
        Slots = slots,
        PadEmpty = true,
        Label = "Racha reciente",
        Modifier = "v2-form--header"
    };
}
@await Html.PartialAsync("~/Views/V2/Team/_FormSlots.cshtml", form)
