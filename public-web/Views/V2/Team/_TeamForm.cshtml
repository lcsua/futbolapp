@model PublicWeb.Models.Public.TeamDetailViewModel
@{
    const int slots = 5;
    var letters = Model.LastResults
        .Select(m => PublicWeb.Helpers.TeamDisplayHelper.FormLetter(m, Model.Team.Id))
        .Where(c => c.HasValue)
        .Select(c => c!.Value)
        .Take(slots)
        .ToList();
}
<div class="v2-form v2-form--header" aria-label="Racha reciente">
    <span class="v2-form__label">Racha reciente</span>
    <div class="v2-form__slots" role="list">
        @for (var i = 0; i < slots; i++)
        {
            if (i < letters.Count)
            {
                var letter = letters[i];
                var cls = letter switch
                {
                    'G' => "is-win",
                    'E' => "is-draw",
                    'P' => "is-loss",
                    _ => ""
                };
                <span class="v2-form__slot @cls" role="listitem" title="@(letter == 'G' ? "Ganado" : letter == 'E' ? "Empate" : "Perdido")">@letter</span>
            }
            else
            {
                <span class="v2-form__slot is-empty" role="listitem" title="Sin partido disponible">-</span>
            }
        }
    </div>
</div>
