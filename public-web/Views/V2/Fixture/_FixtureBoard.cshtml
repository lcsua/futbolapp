@model PublicWeb.Models.Public.SeasonGroupedViewModel<PublicWeb.Models.Public.MatchdayGroupViewModel>
@{
    var leagueSlug = ViewBag.LeagueSlug as string
        ?? (ViewBag.League as PublicWeb.Models.Public.LeagueViewModel)?.Slug
        ?? "";
    var seasonSlug = Model?.SeasonSlug ?? ViewBag.SeasonSlug as string ?? "";
    var selectedDivision = ViewBag.Division as string ?? "all";
    var requestingFecha = ViewBag.Fecha as int?;

    ViewData["LeagueSlug"] = leagueSlug;
    ViewData["SeasonSlug"] = seasonSlug;
    ViewData["PageDivision"] = selectedDivision;
}
<div class="v2-fixture-board"
     data-v2-fixture-board
     data-season="@seasonSlug"
     data-page-division="@selectedDivision">
    @if (Model != null && Model.Divisions.Any())
    {
        foreach (var div in Model.Divisions)
        {
            // Single-division URL fecha applies; each "all" block uses its DefaultRound.
            ViewData["BlockFecha"] = selectedDivision != "all" ? requestingFecha : null;
            @await Html.PartialAsync("~/Views/V2/Fixture/_FixtureDivisionBlock.cshtml", div)
        }
    }
    else
    {
        <div class="v2-empty">No hay partidos registrados.</div>
    }
</div>
