@model PublicWeb.Models.Public.LeaguesIndexPageViewModel
@{
    Layout = "~/Views/Shared/V2/_V2Layout.cshtml";
    ViewData["Title"] = "Ligas";
}
<section>
    <h1 class="v2-page-title">Ligas</h1>
    <p class="v2-page-lead" style="margin-bottom: var(--space-6, 1.5rem)">
        Elegí una competición para ver resultados, posiciones y fixture.
    </p>

    @if (Model.AmateurLeagues == null || !Model.AmateurLeagues.Any())
    {
        <div class="v2-empty">No hay ligas públicas disponibles.</div>
    }
    else
    {
        <div class="v2-stack">
            @foreach (var league in Model.AmateurLeagues)
            {
                <a class="v2-league-card" href="@Url.Content($"~/ligas/{league.Slug}")">
                    @await Html.PartialAsync("~/Views/V2/Team/_TeamBadge.cshtml", new PublicWeb.Models.Public.TeamViewModel
                    {
                        Name = league.Name,
                        LogoUrl = league.LogoUrl
                    })
                    <span class="v2-league-card__copy">
                        <span class="v2-league-card__name">@league.Name</span>
                        @if (!string.IsNullOrWhiteSpace(league.Country))
                        {
                            <span class="v2-league-card__meta">@league.Country</span>
                        }
                    </span>
                    <span class="v2-league-card__arrow" aria-hidden="true">→</span>
                </a>
            }
        </div>
    }
</section>

<section class="v2-home-section" aria-labelledby="torneos-argentinos-heading" style="margin-top: var(--space-8, 2.5rem)">
    <h2 id="torneos-argentinos-heading" class="v2-section-title">Torneos Argentinos</h2>
    <p class="v2-page-lead" style="margin: 0.35rem 0 1rem">Competencias profesionales de fútbol argentino.</p>

    @if (Model.ArgentineTournamentsUnavailable && (Model.ArgentineTournaments == null || !Model.ArgentineTournaments.Any()))
    {
        <div class="v2-empty">No pudimos obtener la información del torneo en este momento. Intentá nuevamente más tarde.</div>
    }
    else if (Model.ArgentineTournaments == null || !Model.ArgentineTournaments.Any())
    {
        <div class="v2-empty">No hay torneos profesionales disponibles por el momento.</div>
    }
    else
    {
        <div class="v2-stack">
            @foreach (var tournament in Model.ArgentineTournaments)
            {
                var tournamentMeta = !string.IsNullOrWhiteSpace(tournament.Country)
                    ? tournament.Country
                    : $"{tournament.CurrentTournament} {(tournament.Season > 0 ? tournament.Season.ToString() : "")}".Trim();
                <a class="v2-league-card" href="@Url.Content($"~/ligas/argentina/{tournament.Slug}")">
                    @await Html.PartialAsync("~/Views/V2/Team/_TeamBadge.cshtml", new PublicWeb.Models.Public.TeamViewModel
                    {
                        Name = tournament.Name,
                        LogoUrl = tournament.LogoUrl
                    })
                    <span class="v2-league-card__copy">
                        <span class="v2-league-card__name">@tournament.Name</span>
                        @if (!string.IsNullOrWhiteSpace(tournamentMeta))
                        {
                            <span class="v2-league-card__meta">@tournamentMeta</span>
                        }
                    </span>
                    <span class="v2-league-card__arrow" aria-hidden="true">→</span>
                </a>
            }
        </div>
    }
</section>
