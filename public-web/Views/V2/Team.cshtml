@model PublicWeb.Models.Public.TeamDetailViewModel
@{
    Layout = "~/Views/Shared/V2/_V2Layout.cshtml";
    ViewBag.OverlayGlobalHeader = true;
    var league = Model.League ?? ViewBag.League as PublicWeb.Models.Public.LeagueViewModel;
    var seasons = ViewBag.Seasons as List<PublicWeb.Models.Public.SeasonViewModel>;
    var summary = ViewBag.V2Summary as PublicWeb.Models.Public.TeamDetailViewModel ?? Model;
    var leagueSlug = league?.Slug ?? string.Empty;
    var teamSlug = Model.Team.Slug;
    var activeTab = (ViewBag.V2TeamTab as string) ?? "resumen";
    var seasonSlug = Model.Season?.Slug;
    ViewData["Title"] = Model.Team.Name + (league != null ? $" · {league.Name}" : string.Empty);
    ViewData["Description"] = $"Ficha de {Model.Team.Name} en {league?.Name}.";

    if (league != null)
    {
        PublicWeb.Seo.SeoPageApplicator.Apply(
            PublicWeb.Seo.SeoCopy.TeamPage(Model.Team.Name, league.Name, leagueSlug, teamSlug, Model.Team.LogoUrl),
            ViewData,
            ViewBag);
    }

    var lastMatch = summary.LastResults.FirstOrDefault();
    var nextMatch = summary.NextMatches.FirstOrDefault();
    var standing = Model.Standing ?? summary.Standing;
    var upcomingSharePath = !string.IsNullOrWhiteSpace(leagueSlug) && !string.IsNullOrWhiteSpace(teamSlug)
        ? $"/ligas/{leagueSlug}/{teamSlug}?share=proximo"
        : null;

    // WhatsApp/Facebook follow canonical/og:url. Keep the query on this variant so
    // the preview stays on the match OG instead of bouncing to the generic team page.
    var shareUpcoming = string.Equals(Context.Request.Query["share"], "proximo", StringComparison.OrdinalIgnoreCase);
    if (nextMatch != null && shareUpcoming)
    {
        ViewData["OgTitle"] = PublicWeb.Helpers.TeamDisplayHelper.FormatUpcomingOgTitle(nextMatch);
        ViewData["Description"] = PublicWeb.Helpers.TeamDisplayHelper.FormatUpcomingOgDescription(nextMatch, league?.Name);
        if (upcomingSharePath != null)
            ViewData["CanonicalPath"] = upcomingSharePath;
        ViewData["NoIndex"] = true;
    }
}

@{
    var teamCrumbs = ViewBag.SeoBreadcrumbs as IReadOnlyList<PublicWeb.Seo.SeoBreadcrumbItem>;
}
<nav class="v2-crumb" aria-label="Migajas">
    @if (teamCrumbs != null && teamCrumbs.Count > 1)
    {
        <div class="v2-crumb__desktop">
            @for (var i = 0; i < teamCrumbs.Count; i++)
            {
                var c = teamCrumbs[i];
                if (i > 0)
                {
                    <span aria-hidden="true">/</span>
                }
                if (!string.IsNullOrWhiteSpace(c.Path) && i < teamCrumbs.Count - 1)
                {
                    <a href="@Url.Content("~" + c.Path)">@c.Name</a>
                }
                else
                {
                    <span aria-current="page">@c.Name</span>
                }
            }
        </div>
    }
    else
    {
        <div class="v2-crumb__desktop">
            <a href="@Url.Content("~/ligas")">Ligas</a>
            @if (league != null)
            {
                <span aria-hidden="true">/</span>
                <a href="@Url.Content($"~/ligas/{leagueSlug}")">@league.Name</a>
            }
            <span aria-hidden="true">/</span>
            <span aria-current="page">@Model.Team.Name</span>
        </div>
    }
    @if (league != null)
    {
        <a class="v2-crumb__mobile" href="@Url.Content($"~/ligas/{leagueSlug}")">
            <span aria-hidden="true">‹</span> @league.Name
        </a>
    }
    else
    {
        <a class="v2-crumb__mobile" href="@Url.Content("~/ligas")">
            <span aria-hidden="true">‹</span> Ligas
        </a>
    }
</nav>

@await Html.PartialAsync("~/Views/V2/Team/_TeamHeader.cshtml", Model)

@await Html.PartialAsync("~/Views/V2/Team/_TeamForm.cshtml", summary)

@if (seasons != null && seasons.Count > 1)
{
    <form method="get" class="v2-toolbar" data-v2-season-form>
        <input type="hidden" name="tab" value="@activeTab" data-v2-season-tab />
        <label for="v2-season" class="visually-hidden">Temporada</label>
        <select id="v2-season" name="season" class="v2-select" onchange="this.form.submit()">
            @foreach (var s in seasons)
            {
                if (Model.Season != null && Model.Season.Slug == s.Slug)
                {
                    <option value="@s.Slug" selected>@s.Name</option>
                }
                else
                {
                    <option value="@s.Slug">@s.Name</option>
                }
            }
        </select>
    </form>
}

<div class="v2-team-tabs" data-v2-team-tabs data-v2-initial-tab="@activeTab">
    <div class="v2-tabs" role="tablist" aria-label="Secciones del equipo">
        <button type="button"
                class="v2-tabs__link @(activeTab == "resumen" ? "is-active" : null)"
                role="tab"
                id="tab-resumen"
                data-v2-tab="resumen"
                aria-controls="panel-resumen"
                aria-selected="@(activeTab == "resumen" ? "true" : "false")"
                tabindex="@(activeTab == "resumen" ? "0" : "-1")">Resumen</button>
        <button type="button"
                class="v2-tabs__link @(activeTab == "partidos" ? "is-active" : null)"
                role="tab"
                id="tab-partidos"
                data-v2-tab="partidos"
                aria-controls="panel-partidos"
                aria-selected="@(activeTab == "partidos" ? "true" : "false")"
                tabindex="@(activeTab == "partidos" ? "0" : "-1")">Partidos</button>
        <button type="button"
                class="v2-tabs__link @(activeTab == "estadisticas" ? "is-active" : null)"
                role="tab"
                id="tab-estadisticas"
                data-v2-tab="estadisticas"
                aria-controls="panel-estadisticas"
                aria-selected="@(activeTab == "estadisticas" ? "true" : "false")"
                tabindex="@(activeTab == "estadisticas" ? "0" : "-1")">Estadísticas</button>
    </div>

    <section id="panel-resumen"
             class="v2-panel"
             role="tabpanel"
             aria-labelledby="tab-resumen"
             data-v2-panel="resumen"
             @(activeTab == "resumen" ? null : "hidden")>
        <div class="v2-summary-grid">
            @if (lastMatch != null)
            {
                @await Html.PartialAsync("~/Views/V2/Team/_FeaturedResult.cshtml", lastMatch)
            }
            else
            {
                <div class="v2-empty">Todavía no hay resultados cargados.</div>
            }

            @if (nextMatch != null)
            {
                ViewData["UpcomingSharePath"] = upcomingSharePath;
                ViewData["UpcomingShareLeague"] = league?.Name;
                @await Html.PartialAsync("~/Views/V2/Team/_FeaturedUpcoming.cshtml", nextMatch)
            }
            else
            {
                <div class="v2-empty">Sin próximo partido programado.</div>
            }
        </div>
    </section>

    <section id="panel-partidos"
             class="v2-panel"
             role="tabpanel"
             aria-labelledby="tab-partidos"
             data-v2-panel="partidos"
             @(activeTab == "partidos" ? null : "hidden")>
        <h2 class="v2-section-title">Resultados</h2>
        <div class="v2-match-list">
            @if (Model.LastResults.Any())
            {
                foreach (var match in Model.LastResults)
                {
                    @await Html.PartialAsync("~/Views/V2/Team/_MatchRow.cshtml", match)
                }
            }
            else
            {
                <div class="v2-empty">Sin resultados recientes.</div>
            }
        </div>
        @{
            ViewData["Page"] = Model.LastResultsPage;
            ViewData["TotalPages"] = Model.LastResultsTotalPages;
            ViewData["ParamName"] = "resultadosPage";
            ViewData["OtherParamName"] = "proximosPage";
            ViewData["OtherParamValue"] = Model.NextMatchesPage;
            ViewData["Tab"] = "partidos";
            ViewData["Season"] = seasonSlug;
            ViewData["LeagueSlug"] = leagueSlug;
            ViewData["TeamSlug"] = teamSlug;
            ViewData["Fragment"] = "";
        }
        @await Html.PartialAsync("~/Views/V2/Team/_Pagination.cshtml")

        <h2 class="v2-section-title v2-section-title--spaced">Próximos partidos</h2>
        <div class="v2-match-list">
            @if (Model.NextMatches.Any())
            {
                foreach (var match in Model.NextMatches)
                {
                    @await Html.PartialAsync("~/Views/V2/Team/_MatchRow.cshtml", match)
                }
            }
            else
            {
                <div class="v2-empty">Sin partidos próximos.</div>
            }
        </div>
        @{
            ViewData["Page"] = Model.NextMatchesPage;
            ViewData["TotalPages"] = Model.NextMatchesTotalPages;
            ViewData["ParamName"] = "proximosPage";
            ViewData["OtherParamName"] = "resultadosPage";
            ViewData["OtherParamValue"] = Model.LastResultsPage;
            ViewData["Fragment"] = "";
        }
        @await Html.PartialAsync("~/Views/V2/Team/_Pagination.cshtml")
    </section>

    <section id="panel-estadisticas"
             class="v2-panel"
             role="tabpanel"
             aria-labelledby="tab-estadisticas"
             data-v2-panel="estadisticas"
             @(activeTab == "estadisticas" ? null : "hidden")>
        @if (standing != null)
        {
            <div class="v2-stats-blocks">
                <div class="v2-stats-block">
                    <h2 class="v2-section-title">Rendimiento</h2>
                    <dl class="v2-stats-dl">
                        <div><dt>Partidos jugados</dt><dd class="v2-nums">@standing.Played</dd></div>
                        <div><dt>Ganados</dt><dd class="v2-nums">@standing.Wins</dd></div>
                        <div><dt>Empatados</dt><dd class="v2-nums">@standing.Draws</dd></div>
                        <div><dt>Perdidos</dt><dd class="v2-nums">@standing.Losses</dd></div>
                    </dl>
                </div>
                <div class="v2-stats-block">
                    <h2 class="v2-section-title">Goles</h2>
                    <dl class="v2-stats-dl">
                        <div><dt>A favor</dt><dd class="v2-nums">@standing.GoalsFor</dd></div>
                        <div><dt>En contra</dt><dd class="v2-nums">@standing.GoalsAgainst</dd></div>
                        <div><dt>Diferencia</dt><dd class="v2-nums">@(standing.GoalDifference > 0 ? $"+{standing.GoalDifference}" : standing.GoalDifference.ToString())</dd></div>
                    </dl>
                </div>
                <div class="v2-stats-block">
                    <h2 class="v2-section-title">Puntos</h2>
                    <dl class="v2-stats-dl">
                        <div><dt>Total</dt><dd class="v2-nums v2-stats-dl__accent">@standing.Points</dd></div>
                    </dl>
                </div>
            </div>
        }
        else
        {
            <div class="v2-empty">No hay estadísticas disponibles para esta temporada.</div>
        }
    </section>
</div>

@section Scripts {
    <script src="~/js/v2/team-tabs.js" asp-append-version="true"></script>
}
