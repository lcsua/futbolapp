@model PublicWeb.Models.Public.TeamDetailViewModel
@{
    Layout = "~/Views/Shared/V2/_V2Layout.cshtml";
    var league = Model.League ?? ViewBag.League as PublicWeb.Models.Public.LeagueViewModel;
    var seasons = ViewBag.Seasons as List<PublicWeb.Models.Public.SeasonViewModel>;
    var leagueSlug = league?.Slug ?? string.Empty;
    ViewData["Title"] = Model.Team.Name + (league != null ? $" · {league.Name}" : string.Empty);
    ViewData["Description"] = $"Ficha de {Model.Team.Name} en {league?.Name}.";

    var lastMatch = Model.LastResults.FirstOrDefault();
    var nextMatch = Model.NextMatches.FirstOrDefault();
    var standing = Model.Standing;
}

<nav class="v2-crumb" aria-label="Migajas">
    <a href="@Url.Content("~/v2/ligas")">Ligas</a>
    @if (league != null)
    {
        <span aria-hidden="true">/</span>
        <a href="@Url.Content($"~/ligas/{leagueSlug}")">@league.Name</a>
    }
    <span aria-hidden="true">/</span>
    <span aria-current="page">@Model.Team.Name</span>
</nav>

@await Html.PartialAsync("~/Views/V2/Team/_TeamHeader.cshtml", Model)

@if (seasons != null && seasons.Count > 1)
{
    <form method="get" class="v2-toolbar">
        <label for="v2-season" class="visually-hidden">Temporada</label>
        <select id="v2-season" name="season" class="v2-select" onchange="this.form.submit()">
            @foreach (var s in seasons)
            {
                if (Model.Season != null && Model.Season.Slug == s.Slug)
                {
                    <option value="@s.Slug" selected>@s.Name</option>
                }
                else
                {
                    <option value="@s.Slug">@s.Name</option>
                }
            }
        </select>
    </form>
}

<div class="v2-tabs" role="tablist" aria-label="Secciones del equipo">
    <button type="button" class="is-active" role="tab" aria-selected="true" data-v2-tab="resumen">Resumen</button>
    <button type="button" role="tab" aria-selected="false" data-v2-tab="partidos">Partidos</button>
    <button type="button" role="tab" aria-selected="false" data-v2-tab="estadisticas">Estadísticas</button>
</div>

<section class="v2-panel" data-v2-panel="resumen" role="tabpanel">
    @if (lastMatch != null)
    {
        @await Html.PartialAsync("~/Views/V2/Team/_FeaturedResult.cshtml", lastMatch)
    }
    else
    {
        <div class="v2-empty">Todavía no hay resultados cargados.</div>
    }

    @if (nextMatch != null)
    {
        <div class="v2-block-gap">
            @await Html.PartialAsync("~/Views/V2/Team/_FeaturedUpcoming.cshtml", nextMatch)
        </div>
    }

    <div class="v2-block-gap">
        @await Html.PartialAsync("~/Views/V2/Team/_TeamForm.cshtml", Model)
    </div>

    @if (standing != null)
    {
        <p class="v2-inline-stats" aria-label="Resumen de resultados">
            <span><strong>@standing.Wins</strong> G</span>
            <span><strong>@standing.Draws</strong> E</span>
            <span><strong>@standing.Losses</strong> P</span>
            <span class="v2-inline-stats__sep" aria-hidden="true"></span>
            <span><strong>@standing.GoalsFor</strong> GF</span>
            <span><strong>@standing.GoalsAgainst</strong> GC</span>
        </p>
    }
</section>

<section class="v2-panel" data-v2-panel="partidos" role="tabpanel" hidden>
    <h2 class="v2-section-title">Últimos resultados</h2>
    <div class="v2-stack">
        @if (Model.LastResults.Any())
        {
            foreach (var match in Model.LastResults)
            {
                @await Html.PartialAsync("~/Views/V2/Team/_MatchCard.cshtml", match)
            }
        }
        else
        {
            <div class="v2-empty">Sin resultados recientes.</div>
        }
    </div>

    <h2 class="v2-section-title v2-section-title--spaced">Próximos partidos</h2>
    <div class="v2-stack">
        @if (Model.NextMatches.Any())
        {
            foreach (var match in Model.NextMatches)
            {
                @await Html.PartialAsync("~/Views/V2/Team/_MatchCard.cshtml", match)
            }
        }
        else
        {
            <div class="v2-empty">Sin partidos próximos.</div>
        }
    </div>
</section>

<section class="v2-panel" data-v2-panel="estadisticas" role="tabpanel" hidden>
    @if (standing != null)
    {
        <div class="v2-stats-grid" role="list">
            <div class="v2-stats-grid__item" role="listitem"><span class="v2-stats-grid__value">@standing.Played</span><span class="v2-stats-grid__label">PJ</span></div>
            <div class="v2-stats-grid__item" role="listitem"><span class="v2-stats-grid__value">@standing.Wins</span><span class="v2-stats-grid__label">G</span></div>
            <div class="v2-stats-grid__item" role="listitem"><span class="v2-stats-grid__value">@standing.Draws</span><span class="v2-stats-grid__label">E</span></div>
            <div class="v2-stats-grid__item" role="listitem"><span class="v2-stats-grid__value">@standing.Losses</span><span class="v2-stats-grid__label">P</span></div>
            <div class="v2-stats-grid__item" role="listitem"><span class="v2-stats-grid__value">@standing.GoalsFor</span><span class="v2-stats-grid__label">GF</span></div>
            <div class="v2-stats-grid__item" role="listitem"><span class="v2-stats-grid__value">@standing.GoalsAgainst</span><span class="v2-stats-grid__label">GC</span></div>
            <div class="v2-stats-grid__item" role="listitem"><span class="v2-stats-grid__value">@(standing.GoalDifference > 0 ? $"+{standing.GoalDifference}" : standing.GoalDifference.ToString())</span><span class="v2-stats-grid__label">DG</span></div>
            <div class="v2-stats-grid__item" role="listitem"><span class="v2-stats-grid__value is-accent">@standing.Points</span><span class="v2-stats-grid__label">PTS</span></div>
        </div>
    }
    else
    {
        <div class="v2-empty">No hay estadísticas disponibles para esta temporada.</div>
    }
</section>
