@model PublicWeb.Models.Public.PredictionDivisionViewModel
@using System.Globalization
@using System.Text.Json
@{
    var culture = CultureInfo.GetCultureInfo("es-AR");
    string Pct(double value)
    {
        if (value <= 0) return "0%";
        if (value >= 1) return "100%";
        if (value * 100 < 0.1) return "<0,1%";
        if (value * 100 > 99.9) return ">99,9%";
        return (value * 100).ToString("0.0", culture) + "%";
    }
    string Pp(double value)
    {
        var points = value * 100;
        var text = Math.Abs(points) < 0.05 ? "0,0" : points.ToString("+0.0;-0.0", culture);
        return text + " pp";
    }
    var byId = Model.Teams.ToDictionary(team => team.Team.Id);
    var candidates = (Model.Race?.CandidateIds ?? new List<Guid>())
        .Select(id => byId.GetValueOrDefault(id))
        .Where(team => team != null)
        .Cast<PublicWeb.Models.Public.PredictionTeamViewModel>()
        .Take(3)
        .ToList();
    if (candidates.Count == 0)
        candidates = Model.Teams.OrderByDescending(team => team.TitleProbability).Take(2).ToList();
    var history = Model.History;
    var chartTeams = candidates.Take(3).ToList();
    if (chartTeams.Count < 3 && history?.Available == true)
    {
        var last = history.Rounds.LastOrDefault();
        if (last != null)
        {
            chartTeams = last.Teams
                .OrderByDescending(team => team.TitleProbability)
                .Take(3)
                .Select(point => byId.GetValueOrDefault(point.TeamId))
                .Where(team => team != null)
                .Cast<PublicWeb.Models.Public.PredictionTeamViewModel>()
                .ToList();
        }
    }
    var chartPayload = history?.Available == true
        ? new
        {
            rounds = history.Rounds.Select(round => new { round = round.Round, reconstructed = round.Reconstructed }).ToList(),
            series = chartTeams.Select((team, index) => new
            {
                id = team.Team.Id,
                name = team.Team.Name,
                color = index == 0 ? "#22c55e" : index == 1 ? "#3b82f6" : "#f59e0b",
                points = history.Rounds.Select(round =>
                {
                    var hit = round.Teams.FirstOrDefault(item => item.TeamId == team.Team.Id);
                    return hit == null ? (double?)null : hit.TitleProbability;
                }).ToList()
            }).ToList()
        }
        : null;
}

@if (Model.Race != null && candidates.Count > 0)
{
    <section class="v2-story-race" id="pred-campeonato-@Model.DivisionSlug" aria-labelledby="story-race-@Model.DivisionSlug">
        <div class="v2-story-race__top">
            <h4 id="story-race-@Model.DivisionSlug">
                <span class="v2-ui-icon v2-ui-icon--trophy" aria-hidden="true"></span>
                La carrera por el título
            </h4>
            <p>@Model.Race.Headline</p>
        </div>
        <div class="v2-story-race__duel v2-story-race__duel--@Math.Min(3, candidates.Count)">
            @{
                var raceLeagueSlug = ViewBag.LeagueSlug as string ?? string.Empty;
            }
            @for (var i = 0; i < candidates.Count; i++)
            {
                var team = candidates[i];
                var barWidth = (Math.Clamp(team.TitleProbability, 0, 1) * 100).ToString("0.#", CultureInfo.InvariantCulture);
                var teamUrl = !string.IsNullOrWhiteSpace(raceLeagueSlug) && !string.IsNullOrWhiteSpace(team.Team.Slug)
                    ? Url.Content($"~/ligas/{raceLeagueSlug}/{team.Team.Slug}")
                    : null;
                <article class="@(i == 0 ? "is-leader" : "is-chaser")">
                    <span class="v2-story-race__tag@(i == 0 ? "" : " v2-story-race__tag--chase")">@(i == 0 ? "Favorito" : "Perseguidor")</span>
                    @{
                        ViewData["BadgeSize"] = "featured";
                        ViewData["BadgePlain"] = true;
                        ViewData["PreferFullLogo"] = true;
                        ViewData["BadgeDecorative"] = true;
                    }
                    @if (teamUrl != null)
                    {
                        <a class="v2-story-race__team" href="@teamUrl">
                            @await Html.PartialAsync("~/Views/V2/Team/_TeamBadge.cshtml", team.Team)
                            <strong class="v2-story-race__name">@team.Team.Name</strong>
                        </a>
                    }
                    else
                    {
                        @await Html.PartialAsync("~/Views/V2/Team/_TeamBadge.cshtml", team.Team)
                        <strong class="v2-story-race__name">@team.Team.Name</strong>
                    }
                    <b class="v2-story-race__pct">@team.TitleLabel</b>
                    <span class="v2-story-race__pts">@team.CurrentPoints pts</span>
                    <span class="v2-story-race__bar" role="presentation" aria-hidden="true"><i style="width:@(barWidth)%"></i></span>
                </article>
            }
            @{
                ViewData.Remove("BadgePlain");
                ViewData.Remove("PreferFullLogo");
                ViewData["BadgeSize"] = "sm";
            }
        </div>
        <dl class="v2-story-race__facts">
            <div><dt>@Model.Race.PointGap</dt><dd>@(Model.Race.PointGap == 1 ? "Punto" : "Puntos") de diferencia</dd></div>
            <div><dt>@Model.Race.MatchesLeft</dt><dd>Partidos de <span>@candidates[0].Team.Name</span></dd></div>
            <div><dt>@Model.Race.PointsInPlay</dt><dd>Puntos en juego de <span>@candidates[0].Team.Name</span></dd></div>
        </dl>
    </section>
}

@if (Model.Paths.Count > 0 || Model.WhatIfs.Count > 0)
{
    <div class="v2-story-split" id="pred-escenarios-@Model.DivisionSlug">
        @if (Model.Paths.Count > 0)
        {
            <section class="v2-story-path" data-story-path aria-labelledby="story-path-@Model.DivisionSlug">
                <h4 id="story-path-@Model.DivisionSlug">El camino hacia el título</h4>
                <label>
                    Equipo
                    <select data-path-select>
                        @foreach (var path in Model.Paths.OrderBy(path => byId.GetValueOrDefault(path.TeamId)?.ProjectedRank ?? 99))
                        {
                            var name = byId.GetValueOrDefault(path.TeamId)?.Team.Name ?? "Equipo";
                            <option value="@path.TeamId">@name</option>
                        }
                    </select>
                </label>
                @foreach (var path in Model.Paths)
                {
                    var team = byId.GetValueOrDefault(path.TeamId);
                    var firstPath = Model.Paths[0].TeamId == path.TeamId;
                    <article class="v2-story-path__panel" data-path="@path.TeamId" hidden="@(!firstPath)">
                        <div class="v2-story-path__head">
                            @if (team != null)
                            {
                                ViewData["BadgeSize"] = "md";
                                ViewData["BadgeDecorative"] = true;
                                @await Html.PartialAsync("~/Views/V2/Team/_TeamBadge.cshtml", team.Team)
                            }
                            <div>
                                <strong>@(team?.Team.Name ?? "Equipo")</strong>
                                <p class="v2-story-stance v2-story-stance--@path.Stance"><strong>@path.StanceLabel</strong> @path.Summary</p>
                            </div>
                        </div>
                        @if (path.CanClinchNextRound)
                        {
                            <p class="v2-story-note">Puede consagrarse en la próxima fecha. @path.ClinchNote</p>
                        }
                        <dl class="v2-story-path__nums">
                            <div><dt>@path.CurrentPoints</dt><dd>Puntos actuales</dd></div>
                            <div><dt>@path.MaxPoints</dt><dd>Máximo posible</dd></div>
                            <div><dt>@path.RivalMax</dt><dd>Tope del rival</dd></div>
                        </dl>
                        @if (path.PointsToClinch is int needed)
                        {
                            var missing = Math.Max(0, needed - path.CurrentPoints);
                            if (missing == 0)
                            {
                                <p class="v2-story-path__need">Con los puntos que ya tiene alcanza para asegurar el primer puesto aunque cada rival gane lo suyo.</p>
                            }
                            else
                            {
                                <p class="v2-story-path__need">Le hacen falta <strong>@missing</strong> puntos más para llegar a @needed y asegurar el primer puesto aunque cada rival gane lo suyo.</p>
                            }
                        }
                        else
                        {
                            <p class="v2-story-note">@path.PointsNote</p>
                        }
                        @{
                            var outlook = team;
                            var likelyLow = outlook?.PositionLow ?? path.BestPosition;
                            var likelyHigh = outlook?.PositionHigh ?? path.WorstPosition;
                            var floorNote = path.PositionNote.Contains("puede mover", StringComparison.OrdinalIgnoreCase)
                                ? "Un desempate puede mover ese piso."
                                : path.PositionNote.Contains("más abajo", StringComparison.OrdinalIgnoreCase)
                                    ? "Ese piso puede quedar más abajo de lo que el fixture permite."
                                    : null;
                        }
                        <p class="v2-story-note">
                            Rango probable: @(likelyLow)º a @(likelyHigh)º.
                            @if (path.WorstPosition > likelyHigh)
                            {
                                @:Piso matemático por puntos: @(path.WorstPosition)º.
                            }
                            @floorNote
                        </p>
                        @if (path.Campaigns.Count > 0)
                        {
                            var shownCampaigns = path.Campaigns.Take(5).ToList();
                            var hiddenCampaigns = path.Campaigns.Skip(5).ToList();
                            <h5>Campañas posibles</h5>
                            <p class="v2-story-key">
                                <span><i class="v2-mark v2-mark--G">G</i> gana</span>
                                <span><i class="v2-mark v2-mark--E">E</i> empata</span>
                                <span><i class="v2-mark v2-mark--P">P</i> pierde</span>
                                <span>El orden no sigue el calendario.</span>
                            </p>
                            <ul class="v2-story-campaigns">
                                @foreach (var campaign in shownCampaigns)
                                {
                                    <li>
                                        <span>
                                            @foreach (var mark in campaign.Marks)
                                            {
                                                <i class="v2-mark v2-mark--@mark">@mark</i>
                                            }
                                        </span>
                                        <b>@campaign.Points</b>
                                        @if (campaign.SecuresTitle)
                                        {
                                            <em>Asegura el título</em>
                                        }
                                    </li>
                                }
                            </ul>
                            @if (hiddenCampaigns.Count > 0)
                            {
                                <details class="v2-pred-more">
                                    <summary>Ver más campañas</summary>
                                    <ul class="v2-story-campaigns">
                                        @foreach (var campaign in hiddenCampaigns)
                                        {
                                            <li>
                                                <span>
                                                    @foreach (var mark in campaign.Marks)
                                                    {
                                                        <i class="v2-mark v2-mark--@mark">@mark</i>
                                                    }
                                                </span>
                                                <b>@campaign.Points</b>
                                                @if (campaign.SecuresTitle)
                                                {
                                                    <em>Asegura el título</em>
                                                }
                                            </li>
                                        }
                                    </ul>
                                </details>
                            }
                            <p class="v2-story-note">Escenarios matemáticos de puntos. No son probabilidades. Si el desempate puede definir el puesto, no se marca como título asegurado.</p>
                        }
                    </article>
                }
            </section>
        }

        <div class="v2-story-split__side">
            @if (Model.WhatIfs.Count > 0)
            {
                <section class="v2-story-if" data-story-if aria-labelledby="story-if-@Model.DivisionSlug">
                    <h4 id="story-if-@Model.DivisionSlug">¿Qué pasa si...?</h4>
                    <p>Cómo cambia la probabilidad de título según el resultado del próximo partido.</p>
                    <label>
                        Equipo
                        <select data-if-select>
                            @foreach (var item in Model.WhatIfs)
                            {
                                var name = byId.GetValueOrDefault(item.TeamId)?.Team.Name ?? "Equipo";
                                <option value="@item.TeamId">@name</option>
                            }
                        </select>
                    </label>
                    @foreach (var item in Model.WhatIfs)
                    {
                        var current = byId.GetValueOrDefault(item.TeamId);
                        var currentTitle = current?.TitleProbability ?? 0;
                        var firstIf = Model.WhatIfs[0].TeamId == item.TeamId;
                        <article class="v2-story-if__panel" data-if="@item.TeamId" hidden="@(!firstIf)"
                                 data-win="@item.WinTitle.ToString(CultureInfo.InvariantCulture)"
                                 data-draw="@item.DrawTitle.ToString(CultureInfo.InvariantCulture)"
                                 data-loss="@item.LossTitle.ToString(CultureInfo.InvariantCulture)"
                                 data-current="@currentTitle.ToString(CultureInfo.InvariantCulture)"
                                 data-win-ok="@(item.WinReliable ? "1" : "0")"
                                 data-draw-ok="@(item.DrawReliable ? "1" : "0")"
                                 data-loss-ok="@(item.LossReliable ? "1" : "0")">
                            <p>Próximo encuentro · Fecha @item.Round · vs @item.OpponentName</p>
                            <div class="v2-story-if__choices" role="group" aria-label="Resultado del próximo partido">
                                <button type="button" data-outcome="win">Gana</button>
                                <button type="button" data-outcome="draw">Empata</button>
                                <button type="button" data-outcome="loss">Pierde</button>
                            </div>
                            <p class="v2-story-if__result" data-if-result></p>
                            <ul class="v2-story-if__rivals">
                                @foreach (var rival in item.Rivals)
                                {
                                    <li data-rival
                                        data-win="@rival.IfWin.ToString(CultureInfo.InvariantCulture)"
                                        data-draw="@rival.IfDraw.ToString(CultureInfo.InvariantCulture)"
                                        data-loss="@rival.IfLoss.ToString(CultureInfo.InvariantCulture)"
                                        data-current="@((byId.GetValueOrDefault(rival.TeamId)?.TitleProbability ?? 0).ToString(CultureInfo.InvariantCulture))">
                                        <span>@rival.Name</span>
                                        <b data-rival-result></b>
                                    </li>
                                }
                            </ul>
                            <p class="v2-story-note">Si un escenario tiene poca muestra, se aclara y no se presenta como preciso.</p>
                        </article>
                    }
                </section>
            }

            @if (Model.Published)
            {
                @await Html.PartialAsync("~/Views/V2/Predictions/_TitleOdds.cshtml", Model)
            }
        </div>
    </div>
}
else if (Model.Published)
{
    @await Html.PartialAsync("~/Views/V2/Predictions/_TitleOdds.cshtml", Model)
}

@if (history?.Available == true && history.Rounds.Count >= 2 && chartTeams.Count > 0 && chartPayload != null)
{
    var rounds = history.Rounds;
    var previous = rounds[^2];
    var latest = rounds[^1];
    <section class="v2-story-history" id="pred-evolucion-@Model.DivisionSlug" aria-labelledby="story-history-@Model.DivisionSlug" data-story-history>
        <h4 id="story-history-@Model.DivisionSlug">Así evolucionó el campeonato</h4>
        <p class="v2-story-history__lead">Probabilidades de título por jornada</p>
        <div class="v2-story-chart-shell">
            <svg class="v2-story-chart" viewBox="0 0 360 210" role="img" aria-label="Evolución de la probabilidad de título" data-history-chart></svg>
            <div class="v2-story-chart-tip" data-history-tip hidden></div>
        </div>
        <script type="application/json" data-history-json>@Html.Raw(JsonSerializer.Serialize(chartPayload))</script>
        <ul class="v2-story-legend" data-history-legend>
            @for (var i = 0; i < chartTeams.Count; i++)
            {
                <li class="is-@(i == 0 ? "a" : i == 1 ? "b" : "c")" data-series="@chartTeams[i].Team.Id">
                    <button type="button" data-series-toggle="@chartTeams[i].Team.Id" aria-pressed="true">@chartTeams[i].Team.Name</button>
                </li>
            }
        </ul>
        <p class="v2-story-chart-key"><span class="is-live"></span> Registrada <span class="is-ghost"></span> Reconstruida *</p>
        <label class="v2-story-history__pick">
            Consultar jornada
            <select data-history-round>
                @for (var i = 0; i < rounds.Count; i++)
                {
                    <option value="@i" selected="@(i == rounds.Count - 1)">Fecha @rounds[i].Round@(rounds[i].Reconstructed ? "*" : "")</option>
                }
            </select>
        </label>
        <ul class="v2-story-moves" data-history-moves>
            @foreach (var team in chartTeams)
            {
                var now = latest.Teams.FirstOrDefault(item => item.TeamId == team.Team.Id)?.TitleProbability ?? team.TitleProbability;
                var before = previous.Teams.FirstOrDefault(item => item.TeamId == team.Team.Id)?.TitleProbability ?? now;
                var delta = now - before;
                <li data-team="@team.Team.Id">
                    <span>@team.Team.Name <small data-move-pct>@Pct(now)</small></span>
                    @if (Math.Abs(delta * 100) < 0.05)
                    {
                        <b>sin cambio</b>
                    }
                    else
                    {
                        <b class="@(delta > 0 ? "is-up" : "is-down")" data-move-pp>@Pp(delta)</b>
                    }
                </li>
            }
        </ul>
        @if (rounds.Any(round => round.Reconstructed))
        {
            <p class="v2-story-note">* Estimaciones históricas reconstruidas.</p>
        }
    </section>
}
else if (!string.IsNullOrWhiteSpace(history?.Note))
{
    <p class="v2-story-note">@history.Note</p>
}
