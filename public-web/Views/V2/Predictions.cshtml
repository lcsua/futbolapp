@model PublicWeb.Models.Public.PredictionsPageViewModel
@using System.Globalization
@{
    Layout = "~/Views/Shared/V2/_V2Layout.cshtml";
    ViewBag.LeagueDetails = true;
    ViewBag.OverlayGlobalHeader = true;
    var league = ViewBag.League as PublicWeb.Models.Public.LeagueViewModel;
    var seasons = ViewBag.Seasons as List<PublicWeb.Models.Public.SeasonViewModel>;
    var leagueSlug = league?.Slug ?? string.Empty;
    var selectedSeason = seasons?.FirstOrDefault(s => string.Equals(s.Slug, Model.SeasonSlug, StringComparison.OrdinalIgnoreCase))
        ?? seasons?.FirstOrDefault();
    var divisions = selectedSeason?.Divisions ?? new List<PublicWeb.Models.Public.DivisionViewModel>();
    var selectedDivision = ViewBag.Division as string ?? "all";
    var focusTeam = ViewBag.FocusTeam as string;
    var culture = CultureInfo.GetCultureInfo("es-AR");
    DateTime ArgentinaTime(DateTime value)
    {
        TimeZoneInfo zone;
        try
        {
            zone = TimeZoneInfo.FindSystemTimeZoneById("America/Argentina/Buenos_Aires");
        }
        catch (TimeZoneNotFoundException)
        {
            zone = TimeZoneInfo.FindSystemTimeZoneById("Argentina Standard Time");
        }
        catch (InvalidTimeZoneException)
        {
            zone = TimeZoneInfo.FindSystemTimeZoneById("Argentina Standard Time");
        }

        var instant = value.Kind switch
        {
            DateTimeKind.Utc => value,
            DateTimeKind.Local => value.ToUniversalTime(),
            _ => DateTime.SpecifyKind(value, DateTimeKind.Utc)
        };
        return TimeZoneInfo.ConvertTimeFromUtc(instant, zone);
    }

    ViewData["Title"] = "Predicciones" + (league != null ? $" · {league.Name}" : string.Empty);
    ViewBag.PageLabel = "Predicciones";
    ViewBag.SeasonName = Model.SeasonName ?? selectedSeason?.Name;
    ViewBag.SeasonSlug = string.IsNullOrWhiteSpace(Model.SeasonSlug) ? selectedSeason?.Slug : Model.SeasonSlug;
    ViewBag.LeagueSlug = leagueSlug;
    var seasonName = ViewBag.SeasonName as string;
    var seasonSlug = ViewBag.SeasonSlug as string;
    string? seoDivisionName = null;
    if (!string.Equals(selectedDivision, "all", StringComparison.OrdinalIgnoreCase))
    {
        seoDivisionName = divisions.FirstOrDefault(d => string.Equals(d.Slug, selectedDivision, StringComparison.OrdinalIgnoreCase))?.Name
            ?? Model.Divisions.FirstOrDefault(d => string.Equals(d.DivisionSlug, selectedDivision, StringComparison.OrdinalIgnoreCase))?.DivisionName;
    }

    if (league != null)
    {
        PublicWeb.Seo.SeoPageApplicator.Apply(
            PublicWeb.Seo.SeoCopy.LeaguePredictions(league.Name, leagueSlug, seasonName, league.LogoUrl, seoDivisionName),
            ViewData,
            ViewBag);
        if (!string.IsNullOrWhiteSpace(seoDivisionName))
            ViewData["OgUrl"] = PublicWeb.Seo.PublicShareLinks.SectionPath(leagueSlug, "predicciones", seasonSlug, selectedDivision);
    }

    string Move(PublicWeb.Models.Public.PredictionTeamViewModel team)
    {
        if (team.OfficialPosition <= 0) return "Nuevo";
        if (team.PlacesDelta > 0) return "▲ " + team.PlacesDelta;
        if (team.PlacesDelta < 0) return "▼ " + (-team.PlacesDelta);
        return "–";
    }

    string MoveClass(PublicWeb.Models.Public.PredictionTeamViewModel team)
    {
        if (team.OfficialPosition <= 0) return "is-new";
        if (team.PlacesDelta > 0) return "is-up";
        if (team.PlacesDelta < 0) return "is-down";
        return "is-same";
    }

    string Places(PublicWeb.Models.Public.PredictionTeamViewModel team)
    {
        if (team.PositionProbability == null || team.PositionProbability.Count == 0)
            return string.Empty;
        var bits = new List<string>();
        for (var i = 0; i < Math.Min(3, team.PositionProbability.Count); i++)
        {
            var value = team.PositionProbability[i];
            string label;
            if (value <= 0) label = "0%";
            else if (value >= 1) label = "100%";
            else if (value * 100 < 0.1) label = "<0,1%";
            else if (value * 100 > 99.9) label = ">99,9%";
            else label = (value * 100).ToString("0.##", culture) + "%";
            bits.Add($"{i + 1}º {label}");
        }
        return string.Join(" · ", bits);
    }
}

@await Html.PartialAsync("~/Views/V2/League/_LeagueBackNav.cshtml")
@await Html.PartialAsync("~/Views/V2/League/_LeagueHeader.cshtml", league)
@await Html.PartialAsync("~/Views/V2/League/_CompetitionTabs.cshtml")
@await Component.InvokeAsync("LeagueAds", new { slot = "LeagueTop" })

<div class="v2-pred">
    <header class="v2-pred-hero">
        <p class="v2-pred-hero__kicker">Estimación</p>
        <div class="v2-pred-hero__title-row">
            <h2 class="v2-pred-hero__title">Predicciones del campeonato</h2>
            @if (!string.IsNullOrWhiteSpace(leagueSlug) && !string.Equals(selectedDivision, "all", StringComparison.OrdinalIgnoreCase))
            {
                ViewData["ShareLeagueSlug"] = leagueSlug;
                ViewData["ShareSection"] = "predicciones";
                ViewData["ShareSeasonSlug"] = seasonSlug;
                ViewData["ShareDivisionSlug"] = selectedDivision;
                ViewData["ShareDivisionName"] = seoDivisionName ?? selectedDivision;
                ViewData["ShareLeagueName"] = league?.Name ?? "";
                @await Html.PartialAsync("~/Views/Shared/V2/_DivisionShareButton.cshtml")
            }
        </div>
        <p class="v2-pred-hero__lead">Una estimación estadística a partir de lo que ya se jugó. No es un resultado oficial y no modifica la tabla.</p>
    </header>

    @{
        var tocDiv = Model.Divisions.FirstOrDefault(item => item.Published);
        var tocDivision = tocDiv?.DivisionSlug;
        var tocHasRace = tocDiv?.Race != null;
        var tocHasScenes = tocDiv != null && (tocDiv.Paths.Count > 0 || tocDiv.WhatIfs.Count > 0);
        var tocHasNext = tocDiv != null && tocDiv.NextRound.Count > 0;
    }
    @if (!string.IsNullOrWhiteSpace(tocDivision) && Model.Divisions.Count(item => item.Published) == 1)
    {
        <nav class="v2-pred-toc" aria-label="Secciones de predicciones">
            @if (tocHasRace)
            {
                <a href="#pred-campeonato-@tocDivision">Campeonato</a>
            }
            @if (tocHasScenes)
            {
                <a href="#pred-escenarios-@tocDivision">Escenarios</a>
            }
            <a href="#pred-proyeccion-@tocDivision">Proyección</a>
            @if (tocHasNext)
            {
                <a href="#pred-fecha-@tocDivision">Próxima fecha</a>
            }
        </nav>
    }

    @if (seasons != null && seasons.Count > 0)
    {
        <form method="get" class="v2-filter-bar" data-division-preference aria-label="Filtros de predicciones" action="@Url.Content($"~/ligas/{leagueSlug}/predicciones")">
            @if (!string.IsNullOrWhiteSpace(focusTeam))
            {
                <input type="hidden" name="equipo" value="@focusTeam" />
            }
            <div class="v2-filter-bar__group">
                <label for="v2-pred-season">Temporada</label>
                <select id="v2-pred-season" name="season" class="v2-select" onchange="this.form.submit()">
                    @foreach (var s in seasons)
                    {
                        if (string.Equals(seasonSlug, s.Slug, StringComparison.OrdinalIgnoreCase))
                        {
                            <option value="@s.Slug" selected>@s.Name</option>
                        }
                        else
                        {
                            <option value="@s.Slug">@s.Name</option>
                        }
                    }
                </select>
            </div>
            <div class="v2-filter-bar__group">
                <label for="v2-pred-division">División</label>
                <select id="v2-pred-division" name="division" class="v2-select" data-division-select onchange="this.form.submit()">
                    @if (selectedDivision == "all")
                    {
                        <option value="all" selected>Todas</option>
                    }
                    else
                    {
                        <option value="all">Todas</option>
                    }
                    @foreach (var d in divisions)
                    {
                        if (string.Equals(selectedDivision, d.Slug, StringComparison.OrdinalIgnoreCase))
                        {
                            <option value="@d.Slug" selected>@d.Name</option>
                        }
                        else
                        {
                            <option value="@d.Slug">@d.Name</option>
                        }
                    }
                </select>
            </div>
        </form>
    }

    @if (!string.IsNullOrWhiteSpace(Model.Warning))
    {
        <p class="v2-pred-banner v2-pred-banner--warn" role="status">@Model.Warning</p>
    }

    @if (Model.Divisions.Count == 0)
    {
        <div class="v2-empty">No hay una división para estimar en esta selección.</div>
    }

    @foreach (var div in Model.Divisions)
    {
        var updated = div.GeneratedAtUtc == default ? Model.GeneratedAtUtc : div.GeneratedAtUtc;
        var showDivisionTitle = Model.Divisions.Count > 1;
        <section class="v2-pred-division"
                 aria-labelledby="@(showDivisionTitle ? $"pred-div-{div.DivisionSlug}" : null)"
                 aria-label="@(showDivisionTitle ? null : $"División {div.DivisionName}")">
            @if (showDivisionTitle)
            {
                <div class="v2-result-group__head">
                    <h3 id="pred-div-@div.DivisionSlug" class="v2-result-group__division">
                        <span class="v2-result-group__division-label">División:</span>
                        <span class="v2-result-group__division-name">@div.DivisionName</span>
                    </h3>
                </div>
            }

            <div class="v2-pred-progress">
                <div class="v2-pred-progress__top">
                    <strong>@div.PlayedPercent% del campeonato jugado</strong>
                    <span>@div.Maturity</span>
                </div>
                <div class="v2-pred-progress__track" role="progressbar" aria-valuemin="0" aria-valuemax="100" aria-valuenow="@div.PlayedPercent" aria-label="Avance del campeonato">
                    <span style="width:@div.PlayedPercent%"></span>
                </div>
                <p>@div.CompletedMatches partidos jugados · @div.PendingMatches pendientes · @div.PendingRounds jornadas por delante.</p>
                @if (updated != default)
                {
                    <p class="v2-pred-updated">Actualizado el @ArgentinaTime(updated).ToString("dd/MM/yyyy HH:mm", culture)</p>
                }
            </div>

            @if (!string.IsNullOrWhiteSpace(div.Limitation))
            {
                <p class="v2-pred-banner" role="status">@div.Limitation</p>
            }
            else if (!div.Published && !string.IsNullOrWhiteSpace(div.UnpublishedReason))
            {
                <p class="v2-pred-banner" role="status">@div.UnpublishedReason</p>
            }

            @if (div.Published)
            {
                @await Html.PartialAsync("~/Views/V2/Predictions/_Story.cshtml", div)

                <section class="v2-pred-block" aria-labelledby="pred-table-@div.DivisionSlug">
                    <h4 id="pred-table-@div.DivisionSlug">Tabla final proyectada</h4>
                    @{
                        var ranked = div.Teams.OrderBy(team => team.ProjectedRank).ToList();
                        var withChance = ranked.Count(team => team.PodiumProbability >= 0.01);
                        var visibleCount = Math.Min(ranked.Count, Math.Max(4, withChance));
                        var shown = ranked.Take(visibleCount).ToList();
                        var hiddenTeams = ranked.Skip(visibleCount).ToList();
                        var restHasFocus = hiddenTeams.Any(team =>
                            !string.IsNullOrWhiteSpace(focusTeam)
                            && string.Equals(team.Team.Slug, focusTeam, StringComparison.OrdinalIgnoreCase));
                    }
                    <div class="v2-pred-scroll">
                        <table class="v2-pred-table">
                            <caption class="visually-hidden">Tabla proyectada de @div.DivisionName. Es una estimación y no modifica los resultados oficiales.</caption>
                            <thead>
                                <tr>
                                    <th scope="col">Pos</th>
                                    <th scope="col">Equipo</th>
                                    <th scope="col" class="v2-pred-col--more">PJ</th>
                                    <th scope="col">Pts</th>
                                    <th scope="col" class="v2-pred-col--more">Pts esp.</th>
                                    <th scope="col" class="v2-pred-col--more">Pos esp.</th>
                                    <th scope="col">Rango</th>
                                    <th scope="col" class="v2-pred-col--more">Pts fin.</th>
                                    <th scope="col">Podio</th>
                                    <th scope="col" class="v2-pred-col--more">Mov.</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var team in shown)
                                {
                                    ViewData["RowFocused"] = !string.IsNullOrWhiteSpace(focusTeam)
                                        && string.Equals(team.Team.Slug, focusTeam, StringComparison.OrdinalIgnoreCase);
                                    ViewData["RowPlaces"] = Places(team);
                                    ViewData["RowMove"] = Move(team);
                                    ViewData["RowMoveClass"] = MoveClass(team);
                                    @await Html.PartialAsync("~/Views/V2/Predictions/_ProjectedRow.cshtml", team)
                                }
                            </tbody>
                        </table>
                    </div>
                    @if (hiddenTeams.Count > 0)
                    {
                        <details class="v2-pred-more" @(restHasFocus ? "open" : null)>
                            <summary>Ver el resto de los equipos</summary>
                            <div class="v2-pred-scroll">
                                <table class="v2-pred-table">
                                    <caption class="visually-hidden">Resto de la tabla proyectada de @div.DivisionName.</caption>
                                    <thead>
                                        <tr>
                                            <th scope="col">Pos</th>
                                            <th scope="col">Equipo</th>
                                            <th scope="col" class="v2-pred-col--more">PJ</th>
                                            <th scope="col">Pts</th>
                                            <th scope="col" class="v2-pred-col--more">Pts esp.</th>
                                            <th scope="col" class="v2-pred-col--more">Pos esp.</th>
                                            <th scope="col">Rango</th>
                                            <th scope="col" class="v2-pred-col--more">Pts fin.</th>
                                            <th scope="col">Podio</th>
                                            <th scope="col" class="v2-pred-col--more">Mov.</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var team in hiddenTeams)
                                        {
                                            ViewData["RowFocused"] = !string.IsNullOrWhiteSpace(focusTeam)
                                                && string.Equals(team.Team.Slug, focusTeam, StringComparison.OrdinalIgnoreCase);
                                            ViewData["RowPlaces"] = Places(team);
                                            ViewData["RowMove"] = Move(team);
                                            ViewData["RowMoveClass"] = MoveClass(team);
                                            @await Html.PartialAsync("~/Views/V2/Predictions/_ProjectedRow.cshtml", team)
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </details>
                    }
                </section>

                @if (div.NextRound.Count > 0)
                {
                    <section class="v2-pred-block" id="pred-fecha-@div.DivisionSlug" aria-labelledby="pred-round-@div.DivisionSlug">
                        <h4 id="pred-round-@div.DivisionSlug">Próxima fecha @(div.NextRoundNumber?.ToString() ?? "")</h4>
                        <p class="v2-pred-note">El marcador es el más repetido. Puede no coincidir con quién tiene más chances de ganar el partido.</p>
                        <div class="v2-pred-matches">
                            @foreach (var match in div.NextRound)
                            {
                                @await Html.PartialAsync("~/Views/V2/Predictions/_MatchCard.cshtml", match)
                            }
                        </div>
                    </section>
                }

                @await Html.PartialAsync("~/Views/V2/Predictions/_ChampionshipHistory.cshtml", div)
            }
            else if (div.Teams.Count > 0)
            {
                <section class="v2-pred-block">
                    <h4>Tabla oficial</h4>
                    <div class="v2-pred-scroll">
                        <table class="v2-pred-table">
                            <caption class="visually-hidden">Tabla oficial de @div.DivisionName.</caption>
                            <thead>
                                <tr>
                                    <th scope="col">Pos</th>
                                    <th scope="col">Equipo</th>
                                    <th scope="col">PJ</th>
                                    <th scope="col">Pts</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var team in div.Teams.OrderBy(team => team.OfficialPosition <= 0 ? int.MaxValue : team.OfficialPosition))
                                {
                                    <tr>
                                        <td>@(team.OfficialPosition > 0 ? team.OfficialPosition.ToString() : "–")</td>
                                        <td class="v2-pred-team">
                                            <span class="v2-pred-team__line">
                                                @{ ViewData["BadgeSize"] = "sm"; ViewData["BadgeDecorative"] = true; }
                                                @await Html.PartialAsync("~/Views/V2/Team/_TeamBadge.cshtml", team.Team)
                                                <span>@team.Team.Name</span>
                                            </span>
                                        </td>
                                        <td>@team.Played</td>
                                        <td>@team.CurrentPoints</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </section>
            }
        </section>
    }
</div>
<script src="~/js/v2/predictions.js" defer></script>
