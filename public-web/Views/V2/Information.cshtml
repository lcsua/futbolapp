@model PublicWeb.Models.Public.LeagueViewModel
@{
    Layout = "~/Views/Shared/V2/_V2Layout.cshtml";
    var league = Model;
    var leagueSlug = league.Slug;
    var docs = ViewBag.LeagueDocuments as PublicWeb.Models.Public.LeagueDocumentsViewModel;
    var categories = docs?.Categories?
        .Where(c => c.Documents != null && c.Documents.Any())
        .ToList()
        ?? new List<PublicWeb.Models.Public.LeagueDocumentCategoryViewModel>();
    var hasAbout = !string.IsNullOrWhiteSpace(league.Description);
    var seasons = ViewBag.Seasons as List<PublicWeb.Models.Public.SeasonViewModel>;

    string FormatBytes(long bytes)
    {
        if (bytes < 1024) return $"{bytes} B";
        if (bytes < 1024 * 1024) return $"{bytes / 1024.0:0.#} KB";
        return $"{bytes / (1024.0 * 1024.0):0.#} MB";
    }

    string FileKind(PublicWeb.Models.Public.LeagueDocumentItemViewModel doc)
    {
        var ct = (doc.ContentType ?? "").ToLowerInvariant();
        if (ct.Contains("pdf") || (doc.OriginalFileName?.EndsWith(".pdf", StringComparison.OrdinalIgnoreCase) ?? false))
            return "PDF";
        if (doc.IsImage) return "Imagen";
        if (!string.IsNullOrWhiteSpace(doc.ContentType)) return doc.ContentType;
        return "Archivo";
    }

    ViewData["Title"] = "Información" + (string.IsNullOrWhiteSpace(league.Name) ? "" : $" · {league.Name}");
    ViewData["Description"] = string.IsNullOrWhiteSpace(league.Description)
        ? $"Información de {league.Name}."
        : league.Description;
    ViewBag.PageLabel = "Información";
    ViewBag.LeagueSlug = leagueSlug;
}

<nav class="v2-crumb" aria-label="Migajas">
    <div class="v2-crumb__desktop">
        <a href="@Url.Content("~/v2/ligas")">Ligas</a>
        <span aria-hidden="true">/</span>
        <a href="@Url.Content($"~/v2/ligas/{leagueSlug}")">@league.Name</a>
        <span aria-hidden="true">/</span>
        <span aria-current="page">Información</span>
    </div>
    <a class="v2-crumb__mobile" href="@Url.Content($"~/v2/ligas/{leagueSlug}")">
        <span aria-hidden="true">‹</span> @league.Name
    </a>
</nav>

@await Html.PartialAsync("~/Views/V2/League/_LeagueHeader.cshtml", league)

@await Html.PartialAsync("~/Views/V2/League/_CompetitionTabs.cshtml")

<div class="v2-info">
    @if (hasAbout)
    {
        <section class="v2-info-section" aria-labelledby="info-about">
            <h2 id="info-about" class="v2-section-title">Acerca de la liga</h2>
            <div class="v2-info-prose">
                @foreach (var para in league.Description!.Split(new[] { "\r\n\r\n", "\n\n" }, StringSplitOptions.RemoveEmptyEntries))
                {
                    <p>@para.Trim()</p>
                }
            </div>
        </section>
    }

    @if (categories.Any())
    {
        <section class="v2-info-section" aria-labelledby="info-useful">
            <h2 id="info-useful" class="v2-section-title">Información útil</h2>

            @foreach (var category in categories)
            {
                <div id="doc-@category.Slug" class="v2-info-category">
                    <h3 class="v2-info-category__title">@category.Name</h3>

                    @foreach (var doc in category.Documents)
                    {
                        if (doc.IsImage)
                        {
                            <article class="v2-info-doc v2-info-doc--image">
                                <h4 class="v2-info-doc__title">@doc.Title</h4>
                                @if (!string.IsNullOrWhiteSpace(doc.Description))
                                {
                                    <p class="v2-info-doc__desc">@doc.Description</p>
                                }
                                <figure class="v2-info-figure">
                                    <a href="@doc.FileUrl" target="_blank" rel="noopener noreferrer">
                                        <img src="@doc.FileUrl"
                                             alt="@doc.Title"
                                             loading="lazy"
                                             decoding="async" />
                                    </a>
                                    <figcaption>Tocá la imagen para verla en tamaño completo.</figcaption>
                                </figure>
                            </article>
                        }
                        else
                        {
                            <article class="v2-info-doc v2-info-doc--file">
                                <div class="v2-info-doc__main">
                                    <h4 class="v2-info-doc__title">@doc.Title</h4>
                                    <p class="v2-info-doc__meta">
                                        @FileKind(doc)
                                        @if (doc.FileSizeBytes > 0)
                                        {
                                            <span aria-hidden="true">·</span>
                                            <span>@FormatBytes(doc.FileSizeBytes)</span>
                                        }
                                        @if (doc.DocumentDate.HasValue)
                                        {
                                            <span aria-hidden="true">·</span>
                                            <span>@doc.DocumentDate.Value.ToString("dd/MM/yyyy")</span>
                                        }
                                    </p>
                                    @if (!string.IsNullOrWhiteSpace(doc.Description))
                                    {
                                        <p class="v2-info-doc__desc">@doc.Description</p>
                                    }
                                </div>
                                <a class="v2-info-doc__dl"
                                   href="@doc.FileUrl"
                                   target="_blank"
                                   rel="noopener noreferrer">
                                    Descargar ↓
                                </a>
                            </article>
                        }
                    }
                </div>
            }
        </section>
    }
    else if (!hasAbout)
    {
        <div class="v2-empty">Todavía no hay información publicada para esta liga.</div>
    }
</div>
