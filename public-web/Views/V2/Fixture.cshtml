@model PublicWeb.Models.Public.SeasonGroupedViewModel<PublicWeb.Models.Public.MatchdayGroupViewModel>
@{
    Layout = "~/Views/Shared/V2/_V2Layout.cshtml";
    var league = ViewBag.League as PublicWeb.Models.Public.LeagueViewModel;
    var seasons = ViewBag.Seasons as List<PublicWeb.Models.Public.SeasonViewModel>;
    var leagueSlug = league?.Slug ?? string.Empty;
    var selectedSeason = seasons?.FirstOrDefault(s => Model != null && Model.SeasonSlug == s.Slug)
        ?? seasons?.FirstOrDefault();
    var divisions = selectedSeason?.Divisions ?? new List<PublicWeb.Models.Public.DivisionViewModel>();
    var selectedDivision = ViewBag.Division as string ?? "all";

    ViewData["Title"] = "Fixture" + (league != null ? $" · {league.Name}" : string.Empty);
    ViewData["Description"] = $"Fixture de {league?.Name}.";
    ViewBag.PageLabel = "Fixture";
    ViewBag.SeasonName = Model?.SeasonName ?? selectedSeason?.Name;
    ViewBag.SeasonSlug = Model?.SeasonSlug ?? selectedSeason?.Slug;
    ViewBag.LeagueSlug = leagueSlug;
}

@await Html.PartialAsync("~/Views/V2/League/_LeagueBackNav.cshtml")

@await Html.PartialAsync("~/Views/V2/League/_LeagueHeader.cshtml", league)

@await Html.PartialAsync("~/Views/V2/League/_CompetitionTabs.cshtml")

@if (seasons != null && seasons.Any())
{
    <form method="get" class="v2-filter-bar" aria-label="Filtros de fixture" data-v2-fixture-filters>
        <div class="v2-filter-bar__group">
            <label for="v2-filter-season">Temporada</label>
            <select id="v2-filter-season" name="season" class="v2-select" onchange="this.form.submit()">
                @foreach (var s in seasons)
                {
                    if (Model != null && Model.SeasonSlug == s.Slug)
                    {
                        <option value="@s.Slug" selected>@s.Name</option>
                    }
                    else
                    {
                        <option value="@s.Slug">@s.Name</option>
                    }
                }
            </select>
        </div>
        <div class="v2-filter-bar__group">
            <label for="v2-filter-division">División</label>
            <select id="v2-filter-division" name="division" class="v2-select" onchange="this.form.submit()">
                @if (selectedDivision == "all")
                {
                    <option value="all" selected>Todas</option>
                }
                else
                {
                    <option value="all">Todas</option>
                }
                @foreach (var d in divisions)
                {
                    if (selectedDivision == d.Slug)
                    {
                        <option value="@d.Slug" selected>@d.Name</option>
                    }
                    else
                    {
                        <option value="@d.Slug">@d.Name</option>
                    }
                }
            </select>
        </div>
    </form>
}

<div data-v2-fixture-root
     data-fragment-url="@Url.Content($"~/ligas/{leagueSlug}/fixture/fragment")"
     data-page-base="@Url.Content($"~/ligas/{leagueSlug}/fixture")"
     data-page-division="@selectedDivision">
    @await Html.PartialAsync("~/Views/V2/Fixture/_FixtureBoard.cshtml", Model)
</div>

@section Scripts {
    <script src="~/js/v2/fixture-nav.js" asp-append-version="true"></script>
}
